          (let complete = cycles(sz - Str::M);
          #pragma diagram {"xy":"h0;v1800","wh":"38000;3200"} #end)
      :1: #1 until if (cycles(2))
      restart #3
      #pragma diagram {"tp":"h17000;v0|#1 h3700 h3700 h-27600;v-3500|#3"} #end;
      :1: #3 until if (cycles(Str::M))
      restart #10
      #pragma diagram {"tp":"h3950;v14800|#3 v1100 v1100 h0;v-7400|#10"} #end;
    #pragma diagram {"xy":"H-6850;V-8000","wh":"111900;65500"} #end)
