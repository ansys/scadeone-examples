type #pragma doc Table 6.5.4.1-1 – Block Structure Exchanged Between UA and CDS at Runtime #end Block_Structure = {layer_id: uint8, context_nb: uint16, nb_cmds: uint16, cmds: Runtime_Command^MAX_NB_CMDS};

type #pragma doc Table 6.5.4.1-2 – Runtime Block Commands #end Runtime_Command = SetParameter{Set_Parameter_Structure} | WidgetEvent{Widget_Event_Structure} | UARequest{UA_request_Structure} | CDSNotification{CDS_Notification_Structure} | ErrorNotification{ Error_Notification_Structure };

type Widget_Event_Structure = {wid: uint16, event_origin: uint16, event: Event_Structure};

type UA_request_Structure = int32;

type Set_Parameter_Structure =  {wid: uint16, nb_params: uint16, params: rt_param^MAX_NB_PARAMS};

type Event_Structure = Selection{} | StringChange{Str::t} | StringConfirmed{Str::t} | StateChange{T::toggle_state} | SelEntryChange{uint16};

type CDS_Notification_Structure = int32;

type Error_Notification_Structure = int32;

const MAX_NB_CMDS: uint16 = 24;

const MAX_NB_PARAMS: uint16 = 20;

const MAX_BLOCK_LOAD_SZ: uint16 = 1024;

const MAX_BLOCK_SZ = MAX_BLOCK_LOAD_SZ + 12;

