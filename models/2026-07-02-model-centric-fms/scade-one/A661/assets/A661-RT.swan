function mk_sp <<NB_PARAMS>> (wid: uint16;
                              params: rt_param^NB_PARAMS;)
  returns (out: Runtime_Command;)
{
  diagram
    (#0 expr wid
    #pragma diagram {"xy":"H-31121;V-11070"} #end)
    (#1 expr #2 @ #3
      where
        (#2 group)
        (#3 group)
    #pragma diagram {"xy":"H-32121;V-5470"} #end)
    (#4 expr NB_PARAMS
    #pragma diagram {"xy":"H-34121;V-14770","wh":"14000;3200"} #end)
    (#5 expr params
    #pragma diagram {"xy":"H-58121;V-7370","wh":"10000;3200"} #end)
    (#6 expr Visible {false}^(MAX_NB_PARAMS - NB_PARAMS)
    #pragma diagram {"xy":"H-75121;V-3570","wh":"44000;3200"} #end)
    (#7 def out
    #pragma diagram {"xy":"H65479;V-11070"} #end)
    (assume $NotTooManyParameters: #9 ; 
      where
        (#9 group)
    #pragma diagram {"xy":"H-34241;V-35870"} #end)
    (#10 expr NB_PARAMS <= MAX_NB_PARAMS
    #pragma diagram {"xy":"H-67241;V-35870","wh":"30000;3200"} #end)
    (#11 expr SetParameter {#12}
      where
        (#12 group)
    #pragma diagram {"xy":"H38479;V-11070","wh":"22000;10000"} #end)
    
    (#13 wire #1 => #12 .(params)
    #pragma diagram {"wp":"#1 h50600 v-4267 #12"} #end)
    (#14 wire #6 => #3)
    (#15 wire #5 => #2)
    (#16 wire #0 => #12 .(wid)
    #pragma diagram {"wp":"#0 h6017 v6600 h46833 v-3933 #12"} #end)
    (#17 wire #4 => #12 .(nb_params)
    #pragma diagram {"wp":"#4 h13050 v-2300 h35300 v3333 #12"} #end)
    (#18 wire #10 => #9)
    (#19 wire #11 => #7)
}
