inline node cycles (n: uint32;)
  returns (over:bool;)
{
  diagram
    (activate #0
      if (n <= 0) pre over
      then
        {
          diagram
            (let over = true;
            #pragma diagram {"xy":"h-12346;v0","wh":"20000;3200"} #end)
        #pragma diagram {"xy":"h0;v-10000","wh":"50000;7200"} #end
        }
      else
        {
          diagram
            (let c = n pre c -1;
             over = c <= 0;
            #pragma diagram {"xy":"h-11458;v-4388","wh":"22000;4219"} #end)
            
            (var
                c;)
        #pragma diagram {"xy":"h0;v7459","wh":"50000;20000"} #end
        }
    #pragma diagram {"xy":"H-39362;V-57062","wh":"50000;34919"} #end)
}

node lat_lon (c: Char::t;
              is_lat: bool;)
  returns (angle: float64 last = 0;
           done:bool default = false;)
{
  diagram
    (var
        sign last = 1;
        deg;
        min last = 0;
        sec last = 0;)
    (automaton #1
      state #3 sign
      #pragma diagram {"xy":"h0;v30449","wh":"104000;15938"} #end :
        diagram
          (let 
               sign = if c = 'S' or c = 'W' then -1 else 1;
               angle = sign * ((last'deg:>float64) + (last'min:>float64) / 60 + (last'sec:>float64) / 3600);
               done = true;
          #pragma diagram {"xy":"h0;v0","wh":"96000;7938"} #end)
      initial state #5 deg
      #pragma diagram {"xy":"h-15264;v-32418","wh":"46000;15999"} #end :
        diagram
