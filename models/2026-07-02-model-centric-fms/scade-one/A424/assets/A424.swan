node number (c: Char::t;
             nb_digits : uint32;
             init: 'T;)
  returns (o: 'T last = init;
           done:bool last = false;)
  where 'T unsigned
{
  diagram
    (var
        digit;)
    (automaton #0
      initial state #2 reading
      #pragma diagram {"xy":"h-25500;v0","wh":"50000;17797"} #end :
        diagram
          (let 
               
               digit, _ = Char::to_digit(c);
               o = (last'o * 10) + (digit :> 'T) ;
          #pragma diagram {"xy":"h0;v0","wh":"42000;9797"} #end)
      state #3 done
      #pragma diagram {"xy":"h30500;v0","wh":"12000;12000"} #end :
      :1: #2 until if (cycles(nb_digits))
      {
        let done = true;
      }
      restart #3
      #pragma diagram {"tp":"h25000;v0|#2 h8333 h8333 h-6000;v0|#3"} #end;
    #pragma diagram {"xy":"H3093;V-19188","wh":"109000;34000"} #end)
}
