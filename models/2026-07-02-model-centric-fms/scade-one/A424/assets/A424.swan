          #pragma diagram {"xy":"h-4962;v960","wh":"34000;7938"} #end)
          
          (var
              digit;)
      :1: #9 until if (cycles(2))
      restart #3
      #pragma diagram {"tp":"h0;v8929|#9 v1876 v1876 h-6525;v-7969|#3"} #end;
      :1: #5 until if (false pre is_lat pre true)
