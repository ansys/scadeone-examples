           digit, _ = Char::to_digit(c);
           deg = (0 pre deg * 10) + digit;
          #pragma diagram {"xy":"h-2000;v960","wh":"34000;6078"} #end)
          
          (var
              digit;)
      state #7 min
      #pragma diagram {"xy":"h-8038;v-12712","wh":"46000;15999"} #end :
        diagram
