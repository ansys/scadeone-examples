          #pragma diagram {"xy":"h0;v1607","wh":"40000;3200"} #end)
      state #4 digits
      #pragma diagram {"xy":"h26616;v-15994","wh":"72000;19657"} #end :
        diagram
          (let 
           digit, is_digit = Char::to_digit(c);
           di32 = (digit :> int32);
           d = sign * di32 -> di32;
           elev = if is_digit then (0 pre elev * 10) + d else 0 pre elev;
           done = cycles(5);
          #pragma diagram {"xy":"h0;v0","wh":"64000;11657"} #end)
          
          (var
              digit;
              di32;
              d;
              is_digit;)
      state #5 done
      #pragma diagram {"xy":"h30012;v12915","wh":"40000;26000"} #end :
      :1: #2 until 
      restart #4
      #pragma diagram {"tp":"h24000;v84|#2 h1744 h1744 h-36000;v-2705|#4"} #end;
      :1: #4 until if (done)
      restart #5
      #pragma diagram {"tp":"h3396;v9828|#4 v2027 v2027 h0;v-13000|#5"} #end;
    #pragma diagram {"xy":"H161113;V4285","wh":"133232;59980"} #end)
}

