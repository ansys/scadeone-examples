-- version swan: 2027.0 graph: 2.1
use Runway;

use Str32 as Str;

function surface_type (surf: Runway::surface_type;)
  returns (s: Str::t;)
{
  diagram
    (#0 expr case #1 of | Runway::ASPHALT: #2 | Runway::CONCRETE: #3 | Runway::ASPHALT_CONCRETE: #4 | Runway::GRASS: #5 | Runway::GRAVEL: #6 | Runway::DIRT: #7 | Runway::SAND: #8 | Runway::SNOW: #9 | Runway::WATER: #10 | Runway::UNKNOWN: #11
      where
        (#1 group)
        (#2 group)
        (#3 group)
        (#4 group)
        (#5 group)
        (#6 group)
        (#7 group)
        (#8 group)
        (#9 group)
        (#10 group)
        (#11 group)
    #pragma diagram {"xy":"H-2500;V-14000","wh":"28000;41200"} #end)
    (#12 expr surf
    #pragma diagram {"xy":"H-32500;V-37600"} #end)
    (#13 def s
    #pragma diagram {"xy":"H27500;V-29200"} #end)
    (#14 expr Str::mk <<7>> (['A', 'S', 'P', 'H', 'A', 'L', 'T'])
    #pragma diagram {"xy":"H-51500;V-29200","wh":"46000;3200"} #end)
    (#15 expr Str::mk <<8>> (['C', 'O', 'N', 'C', 'R', 'E', 'T', 'E'])
    #pragma diagram {"xy":"H-53500;V-25400","wh":"50000;3200"} #end)
    (#16 expr Str::mk <<16>> (['A', 'S', 'P', 'H', 'A', 'L', 'T', '_', 'C', 'O', 'N', 'C', 'R', 'E', 'T', 'E'])
    #pragma diagram {"xy":"H-68500;V-21600","wh":"80000;3200"} #end)
    (#17 expr Str::mk <<5>> (['G', 'R', 'A', 'S', 'S'])
    #pragma diagram {"xy":"H-47500;V-17800","wh":"38000;3200"} #end)
    (#18 expr Str::mk <<6>> (['G', 'R', 'A', 'V', 'E', 'L'])
    #pragma diagram {"xy":"H-49500;V-14000","wh":"42000;3200"} #end)
    (#19 expr Str::mk <<4>> (['D', 'I', 'R', 'T'])
    #pragma diagram {"xy":"H-45500;V-10200","wh":"34000;3200"} #end)
    (#20 expr Str::mk <<4>> (['S', 'A', 'N', 'D'])
    #pragma diagram {"xy":"H-45500;V-6400","wh":"34000;3200"} #end)
    (#21 expr Str::mk <<4>> (['S', 'N', 'O', 'W'])
    #pragma diagram {"xy":"H-45500;V-2600","wh":"34000;3200"} #end)
    (#22 expr Str::mk <<5>> (['W', 'A', 'T', 'E', 'R'])
    #pragma diagram {"xy":"H-47500;V1200","wh":"38000;3200"} #end)
    (#23 expr Str::mk <<7>> (['U', 'N', 'K', 'N', 'O', 'W', 'N'])
    #pragma diagram {"xy":"H-51500;V5000","wh":"46000;3200"} #end)
    
    (#24 wire #12 => #1
    #pragma diagram {"wp":"#12 h21500 #1"} #end)
    (#25 wire #0 => #13)
    (#26 wire #14 => #2)
    (#27 wire #15 => #3)
    (#28 wire #16 => #4)
    (#29 wire #17 => #5)
    (#30 wire #18 => #6)
    (#31 wire #19 => #7)
    (#32 wire #20 => #8)
    (#33 wire #21 => #9)
    (#34 wire #22 => #10)
    (#35 wire #23 => #11)
}
