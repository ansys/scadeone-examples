_harness test_random
{
  diagram
    (#0 def _
    #pragma diagram {"xy":"H56519;V31208"} #end)
    (#1 expr forward
      <<1000>>
      diagram
        (activate #2 $ActivateIf0
          if random::random_true(50)
          then
            {
              diagram
                (let nb_true = last 'nb_true + 1;
                #pragma diagram {"xy":"h0;v0","wh":"36000;3200"} #end)
            #pragma diagram {"xy":"h0;v-4100","wh":"43000;7200"} #end
            }
          else
            {
              diagram
                (let nb_false = last 'nb_false + 1;
                #pragma diagram {"xy":"h0;v0","wh":"36000;3200"} #end)
            #pragma diagram {"xy":"h0;v7300","wh":"43000;7200"} #end
            }
        #pragma diagram {"xy":"h0;v0","wh":"43000;24800"} #end)
      returns (nb_true: last = 0_i32,
               nb_false: last = 0_i32)
    #pragma diagram {"xy":"H10819;V17475","wh":"51600;41200"} #end)
    (#4 def _
    #pragma diagram {"xy":"H38781;V-12775"} #end)
    (#5 expr 50
    #pragma diagram {"xy":"H-20219;V-12775"} #end)
    (#6 def _
    #pragma diagram {"xy":"H56519;V17475"} #end)
    (#7 block random::random_true
    #pragma swt under_test #end
    #pragma diagram {"xy":"H9281;V-12775","wh":"20000;14000"} #end)
    
    (#9 wire #1 .(2) => #0
    #pragma diagram {"wp":"v13733|#1 #0"} #end)
    (#10 wire #1 .(1) => #6
    #pragma diagram {"wp":"v0|#1 #6"} #end)
    (#11 wire #7 => #4
    #pragma diagram {"wp":"v0|#7 #4"} #end)
    (#13 wire #5 => #7)
}

