node TimesBomb (count: 't;
                in: bool;)
  returns (out: bool;)
  where 't signed
{
  diagram
    (#0 expr in and n=0
    #pragma diagram {"xy":"H-68600;V-21700","wh":"14000;3200"} #end)
    (#1 def out
    #pragma diagram {"xy":"H-45600;V-21700"} #end)
    
    (#2 wire #0 => #1)
    
    (var
        n: 't last=count;)
    (activate #3 $ActivateIf0
      if in
      then
        {
          diagram
            (let n = if last'n > 0 then last'n - 1 else count;
            #pragma diagram {"xy":"h-1000;v0","wh":"50000;3200"} #end)
        #pragma diagram {"xy":"h0;v-4100","wh":"59000;7200"} #end
        }
      else
        {
          diagram
            (let n = 0;
            #pragma diagram {"xy":"h0;v0","wh":"14000;3200"} #end)
        #pragma diagram {"xy":"h0;v7300","wh":"59000;7200"} #end
        }
    #pragma diagram {"xy":"H-58400;V-40950","wh":"59000;24800"} #end)
}

