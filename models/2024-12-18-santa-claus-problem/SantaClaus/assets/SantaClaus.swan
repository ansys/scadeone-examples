node selectElves <<NB_ELVES>> (message : Message;
                               statusElves: ElfStatus^NB_ELVES;)
  returns (messageElves: Message^NB_ELVES default=Nothing^NB_ELVES;)
{
  diagram
    (activate #4 $sendMessageToElves when message match
      | ToElf { status } :
        {
          diagram
            (activate #5 $ActivateIf0
              if status = E_ISSUE
              then
                {
                  diagram
                    (/* Whether the elf is selected,
                     starting from index `startIdx` */
                     let
                    #pragma diagram {"xy":"h47261;v2464","wh":"36000;6078"} #end)
                    (#1 def selectedElves
                    #pragma diagram {"xy":"h47261;v-3850","wh":"18000;3200"} #end)
                    (#2 def messageElves
                    #pragma diagram {"xy":"h47261;v13019","wh":"16000;3200"} #end)
                    (#3 expr forward
                      <<NB_ELVES>> with <<i>>
                      diagram
                        (let idx = (last'startIdx + i) mod NB_ELVES;
                             selected = (statusElves.[idx] default E_WORKING) = E_ISSUE;
                             nb = if selected then last'nb + 1 else last'nb;
                        #pragma diagram {"xy":"h0;v0","wh":"64000;6078"} #end)
                        
                        (var
                            nb: int32 last = 0;
                            idx;)
                      until nb >= 3
                      returns ([selected: default=false])
                    #pragma diagram {"xy":"h-28961;v-11889","wh":"72600;22878"} #end)
                    (#16 expr forward
                      <<NB_ELVES>> with <<i>>
                      diagram
                        (let idx = (NB_ELVES - last'startIdx + i) mod NB_ELVES;
                             msg = if (selectedElves.[idx] default false) then message else Nothing;
                        #pragma diagram {"xy":"h0;v0","wh":"76000;4219"} #end)
                        
                        (var
                            idx;)
                      returns ([msg])
                    #pragma diagram {"xy":"h-22861;v13019","wh":"84600;20619"} #end)
                    (#11 def startIdx
                    #pragma diagram {"xy":"h47261;v-12509","wh":"12000;3200"} #end)
                    (#0 block ({op_expr%function i => (i + 1 + last'startIdx)
                                         mod NB_ELVES%op_expr})
                    #pragma diagram {"xy":"h24300;v-12509","wh":"26123;7000"} #end)
                    
                    (#9 wire #3 .(2) => #1
                    #pragma diagram {"wp":"v8040|#3 #1"} #end)
                    (#8 wire #3 .(1) => #0 .(i)
                    #pragma diagram {"wp":"v-619|#3 #0"} #end)
                    (#10 wire #0 => #11
                    #pragma diagram {"wp":"v0|#0 #11"} #end)
                    (#18 wire #16 => #2
                    #pragma diagram {"wp":"v0|#16 #2"} #end)
                    
                    (var
                        startIdx last=0;
                        selectedElves;)
                #pragma diagram {"xy":"h0;v-4100","wh":"137523;50657"} #end
                }
              else
                {
                  diagram
                    (#13 expr message ^ NB_ELVES
                    #pragma diagram {"xy":"h-1800;v0","wh":"22000;3200"} #end)
                    (#14 def messageElves
                    #pragma diagram {"xy":"h29200;v0","wh":"16000;3200"} #end)
                    
                    (#15 wire #13 => #14)
                #pragma diagram {"xy":"h0;v29028","wh":"137523;7200"} #end
                }
            #pragma diagram {"xy":"h50;v0","wh":"137523;68257"} #end)
        #pragma diagram {"xy":"h0;v-7400","wh":"144623;72257"} #end
        }
      | ToReindeer :
        {
        #pragma diagram {"xy":"h0;v36128","wh":"144623;6400"} #end
