  returns (slot: float32;)
{
  diagram
    (let slot = (c.slot :> float32);
    #pragma diagram {"xy":"H0;V0","wh":"34000;3200"} #end)
}

function card_name (c: V::card;)
  returns (name: char ^ WORD;)
{
  diagram
    (let name = if c.present then name_of(c.operation) else NO_NAME; 
    #pragma diagram {"xy":"H5000;V0","wh":"66000;3200"} #end)
}

function card_edge (i: uint32;
                    c: V::card;
                    over: spot;
                    held: spot;
                    grabbed: V::card;)
  returns (edge: int32;)
{
  diagram
    (let
       dragging = held.kind = OnTool or (held.kind = OnCard and grabbed.present);
       edge = if held.kind = OnCard and c.present and grabbed.present
           and c.item = grabbed.item then HELD_COLOR
         else if dragging and over = {kind: OnCard, index: i}: spot then TARGET_COLOR
         else EDGE_COLOR;
    #pragma diagram {"xy":"H0;V0","wh":"80000;9797"} #end)
    
    (var
        dragging: bool;)
}

function cell_color (s: V::slot_view;)
  returns (color: int32;)
{
  diagram
    (let color = if s.used then color_of(s.operation) else FREE_COLOR;
    #pragma diagram {"xy":"H0;V0","wh":"66000;3200"} #end)
}

function cell_version (s: V::slot_view;)
  returns (version: float32;)
{
  diagram
    (let version = (s.version :> float32);
    #pragma diagram {"xy":"H0;V0","wh":"40000;3200"} #end)
}

function cell_next (s: V::slot_view;)
  returns (next: float32;
           linked: bool;)
{
  diagram
    (activate #0 when s.next match
       | V::NoLink :
         {
           diagram
             (let next = 0.0; linked = false;
             #pragma diagram {"xy":"h-7000;v0","wh":"34000;3200"} #end)
         #pragma diagram {"xy":"h0;v-2091","wh":"52000;7200"} #end
         }
       | V::ToSlot {target} :
         {
           diagram
             (let next = (target.slot :> float32); linked = true;
             #pragma diagram {"xy":"h0;v0","wh":"48000;3200"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"52000;7200"} #end
         }
     #pragma diagram {"xy":"H0;V0","wh":"52000;24819"} #end)
}

function cell_roles (s: V::slot_view;)
  returns (head: bool;
           tail: bool;
           free_head: bool;)
{
  diagram
    (let head = s.is_head; tail = s.is_tail; free_head = s.is_free_head;
    #pragma diagram {"xy":"H0;V0","wh":"70000;3200"} #end)
}

function focus_of (cell_hover: bool ^ V::PAGE;
                   over: spot;
                   cards: V::card ^ V::CARDS;)
  returns (focus: V::link;)
{
  diagram
    (let
       cell = (foldi first_set) <<V::PAGE>> (NONE, cell_hover);
       card = (cards .[over.index] default V::NO_CARD);
       focus = if cell <> NONE then V::ToSlot {slot: cell}
         else if over.kind = OnCard and card.present then V::ToSlot {slot: (card.slot :> uint32)}
         else V::NoLink {};
    #pragma diagram {"xy":"H0;V0","wh":"90000;9797"} #end)
    
    (var
        cell: uint32;
        card: V::card;)
}

inline function cell_mark (i: uint32;
                           focus_slot: uint32;
                           f: V::slot_view;)
  returns (outline: int32;)
{
  diagram
    (let
       here = V::ToSlot {slot: i};
       outline = if i = focus_slot then FOCUS_COLOR
         else if f.next = here then NEXT_COLOR
         else if f.used and f.prev = here then PREV_COLOR
         else PLAIN_COLOR;
    #pragma diagram {"xy":"H0;V0","wh":"70000;9797"} #end)
    
    (var
        here: V::link;)
}

function cell_marks (focus: V::link;
                     slots: V::slot_view ^ V::PAGE;)
  returns (outlines: int32 ^ V::PAGE;)
{
  diagram
    (activate #0 when focus match
       | V::NoLink :
         {
           diagram
             (let outlines = PLAIN_COLOR ^ V::PAGE;
             #pragma diagram {"xy":"h-26000;v0","wh":"40000;3200"} #end)
         #pragma diagram {"xy":"h0;v-5247","wh":"96000;7200"} #end
         }
       | V::ToSlot {target} :
         {
           diagram
             (let
                f = (slots .[target.slot] default V::FREE_VIEW);
                outlines = (mapi (cell_mark \ focus_slot: target.slot, f: f)) <<V::PAGE>> ();
             #pragma diagram {"xy":"h0;v-1638","wh":"92000;6078"} #end)
             
             (var
                 f: V::slot_view;)
         #pragma diagram {"xy":"h0;v8889","wh":"96000;13353"} #end
         }
     #pragma diagram {"xy":"H0;V2777","wh":"96000;31131"} #end)
}

function running_view (current: Q::work;)
  returns (color: int32;
           progress: float32;
           name: char ^ WORD;
           remaining: float32;)
{
  diagram
    (activate #0 when current match
       | Q::Idle :
         {
           diagram
             (let color = FREE_COLOR; progress = 0.0; name = IDLE_NAME; remaining = 0.0;
             #pragma diagram {"xy":"h0;v0","wh":"62000;3200"} #end)
         #pragma diagram {"xy":"h0;v-5389","wh":"66000;7200"} #end
         }
       | Q::Working {active} :
         {
           diagram
             (let
                color = color_of(active.job.operation);
                progress = 1.0 - (active.remaining_cycles :> float32)
                  / (active.job.duration_cycles :> float32);
                name = name_of(active.job.operation);
                remaining = (active.remaining_cycles :> float32);
             #pragma diagram {"xy":"h-3000;v0","wh":"56000;11657"} #end)
         #pragma diagram {"xy":"h0;v9739","wh":"66000;15657"} #end
         }
     #pragma diagram {"xy":"H0;V0","wh":"66000;35700"} #end)
}

inline function lit_at (i: uint32;
                        kind: area_kind;
                        over: spot;
                        held: spot;)
  returns (lit: bool;)
{
  diagram
    (let
       here = {kind: kind, index: i}: spot;
       lit = held = here or (held.kind <> Nowhere and over = here)
         or (held.kind = Nowhere and over = here and kind = OnTool);
    #pragma diagram {"xy":"H0;V0","wh":"80000;6078"} #end)
    
    (var
        here: spot;)
}

inline function control_on (i: uint32;
                            paused: bool;
                            pace: pace_kind;)
  returns (lit: bool;)
{
  diagram
    (let lit = if i = PAUSE then paused
       else if is_pace_button(i) then (pace_of_button(i) = pace and not paused)
       else false;
    #pragma diagram {"xy":"H2000;V1859","wh":"74000;7938"} #end)
}

function highlights (over: spot;
