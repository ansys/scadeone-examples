-- version swan: 2027.0 graph: 2.1
use JobList as L;

use Job as Job;

use WorkQueue as Q;

use View as V;

const TOOLS: uint32 = 7;

const ZONES: uint32 = 2;

const CONTROLS: uint32 = 6;

const END_ZONE: uint32 = 0;

const TRASH_ZONE: uint32 = 1;

const PAUSE: uint32 = 0;

const STEP: uint32 = 1;

const SLOW: uint32 = 2;

const NORMAL: uint32 = 3;

const FAST: uint32 = 4;

const FILL: uint32 = 5;

type pace_kind = enum {Slow, Normal, Fast};

const SLOW_PERIOD: uint32 = 50;

const NORMAL_PERIOD: uint32 = 25;

const FAST_PERIOD: uint32 = 5;

const NONE: uint32 = 1000;

const TOOL_OPS: Job::operation ^ TOOLS = [Job::Inspect, Job::Paint, Job::Pack, Job::Drill,
  Job::Rework, Job::SafetyCheck, Job::Production];

type area_kind = enum {Nowhere, OnCard, OnTool, OnZone, OnControl};

type spot = {kind: area_kind, index: uint32};

const NOWHERE: spot = {kind: Nowhere, index: NONE}: spot;

const BLACK: int32 = 1;

const WHITE: int32 = 2;

const LIGHT_GREY: int32 = 4;

const GREY: int32 = 5;

const DARK_GREY: int32 = 6;

const DARKER_GREY: int32 = 7;

const RED: int32 = 11;

const ORANGE: int32 = 21;

const YELLOW: int32 = 31;

const GREEN: int32 = 41;

const CYAN: int32 = 51;

const BLUE: int32 = 61;

const FUCHSIA: int32 = 71;

const FREE_COLOR: int32 = DARKER_GREY;

const NO_COLOR: int32 = GREY;

const EDGE_COLOR: int32 = WHITE;

const TARGET_COLOR: int32 = YELLOW;

const HELD_COLOR: int32 = DARK_GREY;

const ACCEPTED_COLOR: int32 = GREEN;

const REJECTED_COLOR: int32 = RED;

const IDLE_COLOR: int32 = LIGHT_GREY;

const FOCUS_COLOR: int32 = WHITE;

const NEXT_COLOR: int32 = YELLOW;

const PREV_COLOR: int32 = CYAN;

const PLAIN_COLOR: int32 = -1;

const BLACK_INK: int32 = BLACK;

const WHITE_INK: int32 = WHITE;

const WORD: uint32 = 16;

const STATUS_LENGTH: uint32 = 24;

const TEXT: uint32 = 48;

const NO_NAME: char ^ WORD = '\x00' ^ WORD;

const EMPTY_TEXT: char ^ TEXT = '\x00' ^ TEXT;

const elaborate IDLE_NAME: char ^ WORD = ['I', 'd', 'l', 'e'] @ ('\x00' ^ 12);

const elaborate W_ADD: char ^ WORD = ['A', 'd', 'd'] @ ('\x00' ^ 13);

const elaborate W_URGENT: char ^ WORD = ['U', 'r', 'g', 'e', 'n', 't'] @ ('\x00' ^ 10);

const elaborate W_INSERT: char ^ WORD = ['I', 'n', 's', 'e', 'r', 't'] @ ('\x00' ^ 10);

const elaborate W_MOVE: char ^ WORD = ['M', 'o', 'v', 'e'] @ ('\x00' ^ 12);

const elaborate W_CANCEL: char ^ WORD = ['C', 'a', 'n', 'c', 'e', 'l'] @ ('\x00' ^ 10);

const elaborate W_CANCEL_ALL: char ^ WORD = ['C', 'a', 'n', 'c', 'e', 'l', ' ', 'a', 'l', 'l'] @ ('\x00' ^ 6);

const elaborate W_BEFORE: char ^ WORD = ['b', 'e', 'f', 'o', 'r', 'e'] @ ('\x00' ^ 10);

const elaborate W_AFTER: char ^ WORD = ['a', 'f', 't', 'e', 'r'] @ ('\x00' ^ 11);

const elaborate W_TO_END: char ^ WORD = ['t', 'o', ' ', 't', 'h', 'e', ' ', 'e', 'n', 'd'] @ ('\x00' ^ 6);

const elaborate W_GONE_JOB: char ^ WORD = ['a', ' ', 'g', 'o', 'n', 'e', ' ', 'j', 'o', 'b'] @ ('\x00' ^ 6);

inline function first_set (i: uint32;
                           found: uint32;
                           flag: bool;)
  returns (first: uint32;)
{
  diagram
    (let first = if flag and found = NONE then i else found;
    #pragma diagram {"xy":"H0;V0","wh":"52000;3200"} #end)
}

function spot_of (card_hover: bool ^ V::CARDS;
                  tool_hover: bool ^ TOOLS;
                  zone_hover: bool ^ ZONES;
                  control_hover: bool ^ CONTROLS;)
  returns (over: spot;)
{
  diagram
    (let
       card = (foldi first_set) <<V::CARDS>> (NONE, card_hover);
       tool = (foldi first_set) <<TOOLS>> (NONE, tool_hover);
       zone = (foldi first_set) <<ZONES>> (NONE, zone_hover);
       control = (foldi first_set) <<CONTROLS>> (NONE, control_hover);
       over = if card <> NONE then {kind: OnCard, index: card}: spot
         else if tool <> NONE then {kind: OnTool, index: tool}: spot
         else if zone <> NONE then {kind: OnZone, index: zone}: spot
         else if control <> NONE then {kind: OnControl, index: control}: spot
         else NOWHERE;
    #pragma diagram {"xy":"H0;V0","wh":"80000;17235"} #end)
    
    (var
        card: uint32;
        tool: uint32;
        zone: uint32;
        control: uint32;)
}

function drop_command (source: spot;
                       over: spot;
                       clicked: bool;
                       grabbed: V::card;
                       cards: V::card ^ V::CARDS;)
  returns (command: Q::command;)
{
  diagram
    (let
       job = Job::make(TOOL_OPS .[source.index] default Job::Production);
       target = (cards .[over.index] default V::NO_CARD).item;
       on_end = over = {kind: OnZone, index: END_ZONE}: spot;
       on_trash = over = {kind: OnZone, index: TRASH_ZONE}: spot;
       command = if source.kind = OnTool then
           (if over.kind = OnCard then Q::InsertBefore {target: target, job: job}
            else if clicked or on_end then Q::Add {job: job}
            else if on_trash then Q::CancelType {operation: job.operation}
            else Q::Wait {})
         else if source.kind = OnCard and grabbed.present then
           (if clicked or on_trash then Q::Cancel {target: grabbed.item}
            else if over.kind = OnCard and over <> source then Q::Move {item: grabbed.item, before: target}
            else if on_end then Q::Move {item: grabbed.item, before: L::null()}
            else Q::Wait {})
         else Q::Wait {};
    #pragma diagram {"xy":"H0;V0","wh":"90000;30000"} #end)
    
    (var
        job: Job::t;
        target: L::ref;
        on_end: bool;
        on_trash: bool;)
}

function is_pace_button (button: uint32;)
  returns (is_pace: bool;)
{
  diagram
    (let is_pace = button = SLOW or button = NORMAL or button = FAST;
    #pragma diagram {"xy":"H0;V0","wh":"60000;3200"} #end)
}

function pace_of_button (button: uint32;)
  returns (pace: pace_kind;)
{
  diagram
    (let pace = if button = SLOW then Slow
       else if button = FAST then Fast
       else Normal;
    #pragma diagram {"xy":"H0;V0","wh":"60000;6078"} #end)
}

function clicked_control (clicked: bool;
                          over: spot;)
  returns (control: uint32;)
{
  diagram
    (let control = if clicked and over.kind = OnControl then over.index else NONE;
    #pragma diagram {"xy":"H0;V0","wh":"70000;3200"} #end)
}

node drag (over: spot;
           pressed: bool;
           released: bool;
           cards: V::card ^ V::CARDS;)
  returns (source: spot;
           held: spot;
           grabbed: V::card;
           clicked: bool;)
{
  diagram
    (let
       source = if pressed then over else (NOWHERE pre held);
       held = if released then NOWHERE else source;
       grabbed = if pressed then
           (if over.kind = OnCard then (cards .[over.index] default V::NO_CARD) else V::NO_CARD)
         else (V::NO_CARD pre grabbed);
       left = if pressed then false else ((false pre left) or over <> source);
       clicked = released and over = source and not left;
    #pragma diagram {"xy":"H0;V0","wh":"96000;17235"} #end)
    
    (var
        left: bool;)
}

node fill (control: uint32;
           drop: Q::command;)
  returns (command: Q::command;)
{
  diagram
    (let
       fill_pending = if control = FILL then TOOLS else (0 pre fill_pending_next);
       fill_pending_next = if drop = Q::Wait {} and fill_pending > 0 then fill_pending - 1
         else fill_pending;
       command = if drop <> Q::Wait {} then drop
         else if fill_pending > 0 then
           Q::Add {job: Job::make(TOOL_OPS .[TOOLS - fill_pending] default Job::Production)}
         else Q::Wait {};
    #pragma diagram {"xy":"H0;V0","wh":"96000;13516"} #end)
    
    (var
        fill_pending: uint32;
        fill_pending_next: uint32;)
}

node transport (control: uint32;)
  returns (paused: bool;
           pace: pace_kind;)
{
  diagram
    (let
       was_paused = false pre paused;
       paused = if control = PAUSE then not was_paused
         else if control = STEP then true
         else if is_pace_button(control) then false
         else was_paused;
       pace = if is_pace_button(control) then pace_of_button(control) else (Normal pre pace);
    #pragma diagram {"xy":"H0;V0","wh":"90000;11657"} #end)
    
    (var
        was_paused: bool;)
}

node pacer (paused: bool;
            pace: pace_kind;
            control: uint32;)
  returns (run: bool;)
{
  diagram
    (let
       period = (case pace of
         | Slow : SLOW_PERIOD
         | Normal : NORMAL_PERIOD
         | Fast : FAST_PERIOD);
       phase = 0 -> (if pre phase + 1 >= period then 0 else pre phase + 1);
       run = if paused then control = STEP else phase = 0;
    #pragma diagram {"xy":"H0;V0","wh":"90000;11657"} #end)
    
    (var
        period: uint32;
        phase: uint32;)
}

