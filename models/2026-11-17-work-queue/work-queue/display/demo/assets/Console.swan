inline function first_nul (i: uint32;
                           found: uint32;
                           c: char;)
  returns (first: uint32;)
{
  diagram
    (let first = if c = '\x00' and found = NONE then i else found;
    #pragma diagram {"xy":"H0;V0","wh":"60000;3200"} #end)
}

inline function char_at (i: uint32;
                         text: char ^ TEXT;
                         len: uint32;
                         word: char ^ WORD;
                         wlen: uint32;
                         sep: uint32;)
  returns (c: char;)
{
  diagram
    (let c = if i < len then (text .[i] default '\x00')
       else if i < len + sep then ' '
       else if i < len + sep + wlen then (word .[i - len - sep] default '\x00')
       else '\x00';
    #pragma diagram {"xy":"H2000;V0","wh":"74000;9797"} #end)
}

function append (text: char ^ TEXT;
                 len: uint32;
                 word: char ^ WORD;)
  returns (out: char ^ TEXT;
           out_len: uint32;)
{
  diagram
    (let
       found = (foldi first_nul) <<WORD>> (NONE, word);
       wlen = if found = NONE then WORD else found;
       sep = if len > 0 and wlen > 0 then 1 else 0;
       out = (mapi (char_at \ text: text, len: len, word: word, wlen: wlen, sep: sep)) <<TEXT>> ();
       out_len = len + sep + wlen;
    #pragma diagram {"xy":"H0;V0","wh":"90000;11657"} #end)
    
    (var
        found: uint32;
        wlen: uint32;
        sep: uint32;)
}

inline function find_card (i: uint32;
                           found: uint32;
                           c: V::card;
                           r: L::ref;)
  returns (first: uint32;)
{
  diagram
    (let first = if found = NONE and c.present and c.item = r then i else found;
    #pragma diagram {"xy":"H0;V0","wh":"80000;3200"} #end)
}

function job_name (r: L::ref;
                   cards: V::card ^ V::CARDS;
                   grabbed: V::card;)
  returns (name: char ^ WORD;)
{
  diagram
    (let
       found = (foldi (find_card \ r: r)) <<V::CARDS>> (NONE, cards);
       name = if found <> NONE then name_of((cards .[found] default V::NO_CARD).operation)
         else if grabbed.present and grabbed.item = r then name_of(grabbed.operation)
         else W_GONE_JOB;
    #pragma diagram {"xy":"H0;V0","wh":"90000;9797"} #end)
    
    (var
        found: uint32;)
}

function describe (command: Q::command;
                   cards: V::card ^ V::CARDS;
                   grabbed: V::card;)
  returns (text: char ^ TEXT;)
{
  diagram
    (let
       t1, l1 = append(EMPTY_TEXT, 0, verb);
       t2, l2 = append(t1, l1, job_word);
       t3, l3 = append(t2, l2, prep);
       text, _ = append(t3, l3, target);
    #pragma diagram {"xy":"H0;V0","wh":"42000;9797"} #end)
    
    (var
        verb: char ^ WORD;
        job_word: char ^ WORD;
        prep: char ^ WORD;
        target: char ^ WORD;
        t1: char ^ TEXT;
        l1: uint32;
        t2: char ^ TEXT;
        l2: uint32;
        t3: char ^ TEXT;
        l3: uint32;)
    (activate #0 when command match
       | Q::Add {args} :
         {
           diagram
             (let
               verb = W_ADD;
               job_word = name_of(args.job.operation);
               prep = NO_NAME;
               target = NO_NAME;
             #pragma diagram {"xy":"h-11000;v0","wh":"42000;9797"} #end)
         #pragma diagram {"xy":"h0;v-58811","wh":"68000;13797"} #end
         }
       | Q::Urgent {args} :
         {
           diagram
             (let
               verb = W_URGENT;
               job_word = name_of(args.job.operation);
               prep = NO_NAME;
               target = NO_NAME;
             #pragma diagram {"xy":"h-11000;v0","wh":"42000;9797"} #end)
         #pragma diagram {"xy":"h0;v-41314","wh":"68000;13797"} #end
         }
       | Q::InsertBefore {args} :
         {
           diagram
             (let
               verb = W_INSERT;
               job_word = name_of(args.job.operation);
               prep = W_BEFORE;
               target = job_name(args.target, cards, grabbed);
             #pragma diagram {"xy":"h-7000;v0","wh":"50000;9797"} #end)
         #pragma diagram {"xy":"h0;v-23816","wh":"68000;13797"} #end
         }
       | Q::InsertAfter {args} :
         {
           diagram
             (let
               verb = W_INSERT;
               job_word = name_of(args.job.operation);
               prep = W_AFTER;
               target = job_name(args.target, cards, grabbed);
             #pragma diagram {"xy":"h-7000;v0","wh":"50000;9797"} #end)
         #pragma diagram {"xy":"h0;v-6319","wh":"68000;13797"} #end
         }
       | Q::Move {args} :
         {
           diagram
             (let
               verb = W_MOVE;
               job_word = job_name(args.item, cards, grabbed);
               prep = if args.before = L::null() then W_TO_END else W_BEFORE;
               target = if args.before = L::null() then NO_NAME
                 else job_name(args.before, cards, grabbed);
             #pragma diagram {"xy":"h0;v0","wh":"64000;11657"} #end)
         #pragma diagram {"xy":"h0;v12108","wh":"68000;15657"} #end
         }
       | Q::Cancel {args} :
         {
           diagram
             (let
               verb = W_CANCEL;
               job_word = job_name(args.target, cards, grabbed);
               prep = NO_NAME;
               target = NO_NAME;
             #pragma diagram {"xy":"h-6000;v0","wh":"52000;9797"} #end)
         #pragma diagram {"xy":"h0;v30535","wh":"68000;13797"} #end
         }
       | Q::CancelType {args} :
         {
           diagram
             (let
               verb = W_CANCEL_ALL;
               job_word = name_of(args.operation);
               prep = NO_NAME;
               target = NO_NAME;
             #pragma diagram {"xy":"h-13000;v0","wh":"38000;9797"} #end)
         #pragma diagram {"xy":"h0;v48033","wh":"68000;13797"} #end
         }
       | Q::Wait :
         {
           diagram
             (let
               verb = NO_NAME;
               job_word = NO_NAME;
               prep = NO_NAME;
               target = NO_NAME;
             #pragma diagram {"xy":"h-20000;v0","wh":"24000;9797"} #end)
         #pragma diagram {"xy":"h0;v65530","wh":"68000;13797"} #end
         }
     #pragma diagram {"xy":"H-55800;V-1800","wh":"68000;144857"} #end)
}

