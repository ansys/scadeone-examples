function color_of (operation: Job::operation;)
  returns (color: int32;)
{
  diagram
    (let color = (case operation of
       | Job::Inspect : CYAN
       | Job::Paint : ORANGE
       | Job::Pack : GREEN
       | Job::Drill : BLUE
       | Job::Rework : FUCHSIA
       | Job::SafetyCheck : RED
       | Job::Production : YELLOW);
    #pragma diagram {"xy":"H0;V0","wh":"34000;15376"} #end)
}

function name_of (operation: Job::operation;)
  returns (name: char ^ WORD;)
{
  diagram
    (let name = (case operation of
       -- "Inspect"
     
       | Job::Inspect : (['I', 'n', 's', 'p', 'e', 'c', 't'] @ ('\x00' ^ 9))
       -- "Paint"
     
       | Job::Paint : (['P', 'a', 'i', 'n', 't'] @ ('\x00' ^ 11))
       -- "Pack"
     
       | Job::Pack : (['P', 'a', 'c', 'k'] @ ('\x00' ^ 12))
       -- "Drill"
     
       | Job::Drill : (['D', 'r', 'i', 'l', 'l'] @ ('\x00' ^ 11))
       -- "Rework"
     
       | Job::Rework : (['R', 'e', 'w', 'o', 'r', 'k'] @ ('\x00' ^ 10))
       -- "Safety"
     
       | Job::SafetyCheck : (['S', 'a', 'f', 'e', 't', 'y'] @ ('\x00' ^ 10))
       -- "Production"
     
       | Job::Production : (['P', 'r', 'o', 'd', 'u', 'c', 't', 'i', 'o', 'n'] @ ('\x00' ^ 6)));
       
    #pragma diagram {"xy":"H-20000;V13946","wh":"90000;43268"} #end)
}

function status_text (status: Q::command_result;)
  returns (text: char ^ STATUS_LENGTH;)
{
  diagram
    (let text = (case status of
       -- "Accepted"
     
       | Q::Accepted : (['A', 'c', 'c', 'e', 'p', 't', 'e', 'd'] @ ('\x00' ^ 16))
       -- "Rejected: queue full"
     
       | Q::QueueFull : (['R', 'e', 'j', 'e', 'c', 't', 'e', 'd', ':', ' ', 'q', 'u', 'e', 'u', 'e', ' ', 'f', 'u', 'l', 'l'] @ ('\x00' ^ 4))
       -- "Rejected: stale job"
     
       | Q::UnknownJob : (['R', 'e', 'j', 'e', 'c', 't', 'e', 'd', ':', ' ', 's', 't', 'a', 'l', 'e', ' ', 'j', 'o', 'b'] @ ('\x00' ^ 5))
       -- "Rejected: zero duration"
     
       | Q::InvalidDuration : ['R', 'e', 'j', 'e', 'c', 't', 'e', 'd', ':', ' ', 'z', 'e', 'r', 'o', ' ', 'd', 'u', 'r', 'a', 't', 'i', 'o', 'n', '\x00']
       -- "Ready"
     
       | Q::NoCommand : (['R', 'e', 'a', 'd', 'y'] @ ('\x00' ^ 19)));
    #pragma diagram {"xy":"H-3000;V8367","wh":"144000;32111"} #end)
}

function status_color (status: Q::command_result;)
  returns (color: int32;)
{
  diagram
    (let color = if status = Q::Accepted then ACCEPTED_COLOR
       else if status = Q::NoCommand then IDLE_COLOR
       else REJECTED_COLOR;
    #pragma diagram {"xy":"H0;V0","wh":"60000;6078"} #end)
}

