}

function ghost (held: spot;
                grabbed: V::card;)
  returns (visible: bool;
           color: int32;
           name: char ^ WORD;)
{
  diagram
    (let
       operation = if held.kind = OnTool then (TOOL_OPS .[held.index] default Job::Production)
         else grabbed.operation;
       visible = held.kind = OnTool or (held.kind = OnCard and grabbed.present);
       color = color_of(operation);
       name = name_of(operation);
    #pragma diagram {"xy":"H0;V0","wh":"90000;11657"} #end)
    
    (var
        operation: Job::operation;)
}

