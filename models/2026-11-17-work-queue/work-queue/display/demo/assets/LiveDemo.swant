_harness pointer_sessions
{
  diagram
    (#0 expr c
    #pragma diagram {"xy":"H-116300;V-13075"} #end)
    (#5 block session_script
    #pragma diagram {"xy":"H-86800;V-13075","wh":"18000;10000"} #end)
    (#8 def place, 
            pressed, 
            released
    #pragma diagram {"xy":"H-54300;V-16414","wh":"14000;6078"} #end)
    (#9 block hover_on
    #pragma diagram {"xy":"H-53300;V7300","wh":"12000;15400"} #end)
    (#10 block C::station
    #pragma swt under_test #end
    #pragma diagram {"xy":"H-20800;V-2888","wh":"20000;40750"} #end)
    (#12 def over, 
             _, 
             command, 
             _, 
             held,
             _, 
             paused, 
             _,
             current,  
             _, 
             command_status,
             _, 
             _, 
             _
    #pragma diagram {"xy":"H25700;V16879","wh":"20000;26533"} #end)
    (#17 block (map V::card_operation) <<V::CARDS>>
    #pragma diagram {"xy":"H20700;V-18458","wh":"30000;13925"} #end)
    (#18 def ops
    #pragma diagram {"xy":"H62200;V-16471"} #end)
    (#19 block C::ghost
    #pragma diagram {"xy":"H27700;V-2888","wh":"16000;8000"} #end)
    (#20 def ghost_visible
    #pragma diagram {"xy":"H59200;V-2888","wh":"14000;3200"} #end)
    (assert
     $spot_found: over = place;
     $paused_from_first_click: c < 2 or paused;
     $machine_idle_until_step: c >= 24 or current = Q::Idle {};
     $press_alone_does_nothing: not pressed or command = Q::Wait {};
     $clicks_append: c <> 8
       or ops = [Job::Paint, Job::Pack, Job::Drill] @ (V::NO_OPERATION ^ 5);
     $ghost_while_dragging: c <> 10 or (ghost_visible and held = spot_at(C::OnTool, 0));
     $drop_on_card_inserts: c <> 11
       or ops = [Job::Paint, Job::Inspect, Job::Pack, Job::Drill] @ (V::NO_OPERATION ^ 4);
     $drag_card_to_front: c <> 13
       or ops = [Job::Drill, Job::Paint, Job::Inspect, Job::Pack] @ (V::NO_OPERATION ^ 4);
     $drag_card_to_end: c <> 15
       or ops = [Job::Paint, Job::Inspect, Job::Pack, Job::Drill] @ (V::NO_OPERATION ^ 4);
     $click_card_cancels: c <> 17
       or ops = [Job::Paint, Job::Pack, Job::Drill] @ (V::NO_OPERATION ^ 5);
     $trash_cancels_kind: c <> 19
       or ops = [Job::Pack, Job::Drill] @ (V::NO_OPERATION ^ 6);
     $abandoned_gesture: c <> 22
       or (command = Q::Wait {} and ops = [Job::Pack, Job::Drill] @ (V::NO_OPERATION ^ 6));
     $not_dragging_after_release: not released or not ghost_visible;
     $accepted_on_release: not released or c = 2 or c = 22 or c = 24
       or command_status = Q::Accepted;
     $step_runs_one_unit: c < 24
       or (paused and current = Q::Working {job: Job::make(Job::Pack), remaining_cycles: 3}
           and ops = [Job::Drill] @ (V::NO_OPERATION ^ 7));
    #pragma diagram {"xy":"H-2900;V-70854","wh":"90000;40000"} #end)
    (let 
         c = _current_cycle;
         _stop_condition = c >= SESSION_CYCLES;
    #pragma diagram {"xy":"H-80400;V-30685","wh":"44000;6078"} #end)
    
    (#30 wire #0 => #5)
    (#32 wire #5 .(place) => #9
    #pragma diagram {"wp":"v2532|#5 h8250 v17843 #9"} #end)
    (#901 wire #5 .(pressed:, released:) => #10
    #pragma diagram {"wp":"v700|#5 #10"} #end)
    (#900 wire #9 .(card_hover:, 
tool_hover:, 
zone_hover:, 
control_hover:) => #10
    #pragma diagram {"wp":"v0|#9 #10"} #end)
    (#40 wire #10 => #12
    #pragma diagram {"wp":"v10660|#10 h20000 v9107 #12"} #end)
    (#902 wire #10 .(held:, grabbed:) => #19
    #pragma diagram {"wp":"v1554|#10 #19"} #end)
    (#46 wire #10 .(cards) => #17
    #pragma diagram {"wp":"v-13583|#10 #17"} #end)
    (#47 wire #17 => #18
    #pragma diagram {"wp":"v-0|#17 #18"} #end)
    (#48 wire #19 .(visible) => #20
    #pragma diagram {"wp":"v-0|#19 #20"} #end)
    (#2 wire #5 => #8
    #pragma diagram {"wp":"v-3339|#5 #8"} #end)
    
    (var
        c: uint64;
        place: C::spot;
        pressed: bool;
        released: bool;
        over: C::spot;
        command: Q::command;
        held: C::spot;
        paused: bool;
        current: Q::work;
        command_status: Q::command_result;
        ops: Job::operation ^ V::CARDS;
        ghost_visible: bool;)
}

_harness pacing_and_fill
{
  diagram
    (#5 block pacing_script
    #pragma diagram {"xy":"H-64770;V-15650","wh":"18000;10000"} #end)
    (#9 block hover_on
    #pragma diagram {"xy":"H-36520;V-22022","wh":"16000;10000"} #end)
    (#10 block C::station
    #pragma swt under_test #end
    #pragma diagram {"xy":"H21500;V-13800","wh":"20000;30000"} #end)
    (#11 expr if #12 then #90007 else #90008
      where
        (#12 group)
        (#90007 group)
        (#90008 group)
    #pragma diagram {"xy":"H60925;V15550"} #end)
    (#90009 expr 1
    #pragma diagram {"xy":"H46725;V13650","wh":"6000;3200"} #end)
    (#90010 expr 0
    #pragma diagram {"xy":"H46725;V17450","wh":"6000;3200"} #end)
    (#14 expr #15 + #16
      where
        (#15 group)
        (#16 group)
    #pragma diagram {"xy":"H85500;V13650"} #end)
    (#17 expr #18 pre #19
      where
        (#18 group)
        (#19 group)
    #pragma diagram {"dir":"nw","xy":"H85500;V1500"} #end)
    (#20 expr 0
    #pragma diagram {"dir":"nw","xy":"H111000;V-400","wh":"6000;3200"} #end)
    (#21 def runs
    #pragma diagram {"xy":"H111000;V13650"} #end)
    (assert
     $normal_speed: runs = (c + (C::NORMAL_PERIOD :> uint64) - 1) / (C::NORMAL_PERIOD :> uint64);
     $fill_accepted: c < 2 or c > 8 or command_status = Q::Accepted;
     $fill_adds_every_kind: c <> 9
       or queue_length + (if current = Q::Idle {} then 0 else 1) = C::TOOLS;
     $fill_done: c < 9 or command = Q::Wait {};
    #pragma diagram {"xy":"H15525;V-51825","wh":"90000;12000"} #end)
    (#0 expr c
    #pragma diagram {"xy":"H-81690;V-16875"} #end)
    (let 
         c = _current_cycle;
         _stop_condition = c >= PACING_CYCLES;
    #pragma diagram {"xy":"H-66520;V-33042","wh":"44000;6078"} #end)
    (#2 def current, 
            queue_length, 
            command, 
            command_status
    #pragma diagram {"xy":"H64925;V-22106","wh":"18000;7938"} #end)
    
    (#90011 wire #90009 => #90007)
    (#90012 wire #90010 => #90008)
    (#32 wire #5 .(place) => #9
    #pragma diagram {"wp":"v-3186|#5 #9"} #end)
    (#901 wire #5 .(pressed:, released:) => #10
    #pragma diagram {"wp":"v2950|#5 #10"} #end)
    (#900 wire #9 => #10 .(card_hover: , 
tool_hover: , 
zone_hover: , 
control_hover: )
    #pragma diagram {"wp":"v-250|#9 #10"} #end)
    (#39 wire #10 .(run) => #12
    #pragma diagram {"wp":"v5331|#10 h29425 #12"} #end)
    (#40 wire #11 => #16)
    (#41 wire #20 => #18)
    (#42 wire #17 => #15
    #pragma diagram {"wp":"#17 h-2500 v10250 #15"} #end)
    (#43 wire #14 => #19, #21
    #pragma diagram {"wp":"#14 h3500[v-10250 #19, #21]"} #end)
    (#3 wire #10 .(current, 
queue_length, 
command, 
command_status) => #2
    #pragma diagram {"wp":"v-8306|#10 #2"} #end)
    (#4 wire #0 => #5)
    
    (var
        c: uint64;
        runs: uint64;
        command: Q::command;
        queue_length: L::index;
        current: Q::work;
        command_status: Q::command_result;)
}

