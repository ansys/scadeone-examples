    #pragma diagram {"xy":"H25500;V-2600","wh":"20000;30000"} #end)
    (#11 block cell_hover_on
    #pragma diagram {"xy":"H-11000;V-18900","wh":"20000;6000"} #end)
    (#13 block C::focus_of
    #pragma diagram {"xy":"H74000;V-17900","wh":"16000;8000"} #end)
    (#14 block C::cell_marks
    #pragma diagram {"xy":"H112675;V-6900","wh":"16000;8000"} #end)
    (#15 def marks
    #pragma diagram {"xy":"H136000;V-6900","wh":"10000;3200"} #end)
    (#16 block (map C::cell_roles) <<V::PAGE>>
    #pragma diagram {"xy":"H67000;V4168","wh":"30000;16463"} #end)
    (#17 def head, 
             tail, 
             free_head
    #pragma diagram {"xy":"H99600;V7608","wh":"14000;6078"} #end)
    (assert
     $no_focus: (c = 9 or c = 10 or c = 11) or marks = C::PLAIN_COLOR ^ V::PAGE;
     $used_slot_shows_both_links: c <> 9
       or (marks[1] = C::FOCUS_COLOR and marks[2] = C::NEXT_COLOR
           and marks[0] = C::PREV_COLOR and marks[3] = C::PLAIN_COLOR);
     $tail_card_focus: c <> 10
       or (marks[2] = C::FOCUS_COLOR and marks[1] = C::PREV_COLOR
           and marks[0] = C::PLAIN_COLOR and marks[3] = C::PLAIN_COLOR);
     $free_slot_shows_next_only: c <> 11
       or (marks[3] = C::FOCUS_COLOR and marks[4] = C::NEXT_COLOR
           and marks[2] = C::PLAIN_COLOR);
     $roles: c < 8
       or (head[0] and tail[2] and free_head[3]
           and not head[1] and not tail[1] and not free_head[1]);
    #pragma diagram {"xy":"H27000;V-50456","wh":"90000;22000"} #end)
    (let 
         c = _current_cycle;
         _stop_condition = c >= FOCUS_CYCLES;
    #pragma diagram {"xy":"H-54275;V-38043","wh":"42000;6078"} #end)
    
    (#30 wire #0 => #5)
    (#32 wire #5 .(place) => #9
    #pragma diagram {"wp":"v3800|#5 h8325 v9275 #9"} #end)
    (#901 wire #5 .(pressed:, released:) => #10
    #pragma diagram {"wp":"v-600|#5 #10"} #end)
    (#900 wire #9 .(card_hover:, tool_hover:, zone_hover:, control_hover:) => #10
    #pragma diagram {"wp":"v1058|#9 #10"} #end)
    (#39 wire #5 .(hovered_cell) => #11
    #pragma diagram {"wp":"v-4900|#5 h36837 v-3900 #11"} #end)
    (#40 wire #11 => #13 .(cell_hover)
    #pragma diagram {"wp":"v-350|#11 #13"} #end)
    (#902 wire #10 .(over:, shown:cards) => #13
    #pragma diagram {"wp":"v-13150|#10 #13"} #end)
    (#43 wire #13 .(focus) => #14 .(focus)
    #pragma diagram {"wp":"v0|#13 h5300 v9273 #14"} #end)
    (#44 wire #10 .(slots) => #14 .(slots), #16
    #pragma diagram {"wp":"v8768|#10 h8250[v-12250 #14, #16]"} #end)
    (#45 wire #14 .(outlines) => #15
    #pragma diagram {"wp":"v0|#14 #15"} #end)
    (#46 wire #16 => #17
    #pragma diagram {"wp":"v1439|#16 #17"} #end)
    
    (var
        c: uint64;
        marks: int32 ^ V::PAGE;
        head: bool ^ V::PAGE;
        tail: bool ^ V::PAGE;
        free_head: bool ^ V::PAGE;)
}

_harness command_text
{
  diagram
    (let
       c = _current_cycle;
       _stop_condition = c >= 6;
       paint = Job::make(Job::Paint);
       drill = Job::make(Job::Drill);
       cards = V::NO_CARD ^ V::CARDS;
       first = {present: true, item: L::Ref {idx: 0, version: 0}, slot: 0,
                operation: Job::Paint, duration_cycles: 20}: V::card;
       second = {present: true, item: L::Ref {idx: 1, version: 0}, slot: 1,
                 operation: Job::Pack, duration_cycles: 4}: V::card;
       shown = [first, second, V::NO_CARD, V::NO_CARD, V::NO_CARD, V::NO_CARD, V::NO_CARD,
                V::NO_CARD];
       add = C::describe(Q::Add {job: paint}, cards, V::NO_CARD);
       insert = C::describe(Q::InsertBefore {target: second.item, job: drill}, shown, V::NO_CARD);
       to_end = C::describe(Q::Move {item: first.item, before: L::null()}, shown, first);
       gone = C::describe(Q::Cancel {target: L::Ref {idx: 5, version: 2}}, shown, V::NO_CARD);
       all = C::describe(Q::CancelType {operation: Job::Production}, shown, V::NO_CARD);
       nothing = C::describe(Q::Wait {}, shown, V::NO_CARD);
    #pragma diagram {"xy":"H0;V0","wh":"96000;30000"} #end)
    (assert
     $add: add = text_of((['A', 'd', 'd', ' ', 'P', 'a', 'i', 'n', 't'] @ ('\x00' ^ 7)));
     $insert_names_target: (insert .[0] default ' ') = 'I' and (insert .[13] default ' ') = 'b'
       and (insert .[20] default ' ') = 'P' and (insert .[23] default ' ') = 'k'
       and (insert .[24] default ' ') = '\x00';
     $move_to_end: (to_end .[0] default ' ') = 'M' and (to_end .[5] default ' ') = 'P'
       and (to_end .[11] default ' ') = 't' and (to_end .[20] default ' ') = 'd'
       and (to_end .[21] default ' ') = '\x00';
     $gone_job: (gone .[7] default ' ') = 'a' and (gone .[16] default ' ') = 'b'
       and (gone .[17] default ' ') = '\x00';
     $cancel_all: (all .[7] default ' ') = 'a' and (all .[11] default ' ') = 'P'
       and (all .[21] default ' ') = '\x00';
     $wait_is_empty: nothing = C::EMPTY_TEXT;
    #pragma diagram {"xy":"H0;V-36000","wh":"96000;20000"} #end)
    
    (var
        c: uint64;
        paint: Job::t;
        drill: Job::t;
        cards: V::card ^ V::CARDS;
        first: V::card;
        second: V::card;
        shown: V::card ^ V::CARDS;
        add: char ^ C::TEXT;
        insert: char ^ C::TEXT;
        to_end: char ^ C::TEXT;
        gone: char ^ C::TEXT;
        all: char ^ C::TEXT;
        nothing: char ^ C::TEXT;)
}
