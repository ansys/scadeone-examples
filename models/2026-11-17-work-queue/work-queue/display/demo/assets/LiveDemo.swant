-- version swan: 2027.0 graph: 2.1 swant: 1.1
use JobList as L;

use Job as Job;

use WorkQueue as Q;

use View as V;

use Console as C;

use WorkQueuePanel as P;

const SESSION_CYCLES: uint64 = 26;

const PACING_CYCLES: uint64 = 60;

const FOCUS_CYCLES: uint64 = 12;

inline function is_at (i: uint32;
                       kind: C::area_kind;
                       place: C::spot;)
  returns (inside: bool;)
{
  diagram
    (let inside = place = {kind: kind, index: i}: C::spot;
    #pragma diagram {"xy":"H0;V0","wh":"52000;3200"} #end)
}

function hover_on (place: C::spot;)
  returns (card_hover: bool ^ V::CARDS;
           tool_hover: bool ^ C::TOOLS;
           zone_hover: bool ^ C::ZONES;
           control_hover: bool ^ C::CONTROLS;)
{
  diagram
    (let
       card_hover = (mapi (is_at \ kind: C::OnCard, place: place)) <<V::CARDS>> ();
       tool_hover = (mapi (is_at \ kind: C::OnTool, place: place)) <<C::TOOLS>> ();
       zone_hover = (mapi (is_at \ kind: C::OnZone, place: place)) <<C::ZONES>> ();
       control_hover = (mapi (is_at \ kind: C::OnControl, place: place)) <<C::CONTROLS>> ();
    #pragma diagram {"xy":"H0;V0","wh":"90000;9797"} #end)
}

function spot_at (kind: C::area_kind;
                  index: uint32;)
  returns (place: C::spot;)
{
  diagram
    (let place = {kind: kind, index: index}: C::spot;
    #pragma diagram {"xy":"H0;V0","wh":"42000;3200"} #end)
}

inline function cell_is (i: uint32;
                         hovered: uint32;)
  returns (inside: bool;)
{
  diagram
    (let inside = i = hovered;
    #pragma diagram {"xy":"H0;V0","wh":"30000;3200"} #end)
}

inline function pad (i: uint32;
                     word: char ^ C::WORD;)
  returns (c: char;)
{
  diagram
    (let c = (word .[i] default '\x00');
    #pragma diagram {"xy":"H0;V0","wh":"40000;3200"} #end)
}

function text_of (word: char ^ C::WORD;)
  returns (text: char ^ C::TEXT;)
{
  diagram
    (let text = (mapi (pad \ word: word)) <<C::TEXT>> ();
    #pragma diagram {"xy":"H0;V0","wh":"50000;3200"} #end)
}

function session_script (c: uint64;)
  returns (place: C::spot;
           pressed: bool;
           released: bool;)
{
  diagram
    (let place, pressed, released = (case c of
       -- cycle : (place, pressed, released)
       -- 1-2 click Pause
     
       | 1 : (spot_at(C::OnControl, C::PAUSE), true, false)
       | 2 : (spot_at(C::OnControl, C::PAUSE), false, true)
       -- 3-8 click Paint, Pack, Drill
     
       | 3 : (spot_at(C::OnTool, 1), true, false)
       | 4 : (spot_at(C::OnTool, 1), false, true)
       | 5 : (spot_at(C::OnTool, 2), true, false)
       | 6 : (spot_at(C::OnTool, 2), false, true)
       | 7 : (spot_at(C::OnTool, 3), true, false)
       | 8 : (spot_at(C::OnTool, 3), false, true)
       -- 9-11 drag Inspect: over nothing, then onto card 1 (Pack): insert before it
     
       | 9 : (spot_at(C::OnTool, 0), true, false)
       | 10 : (C::NOWHERE, false, false)
       | 11 : (spot_at(C::OnCard, 1), false, true)
       -- 12-13 drag card 3 (Drill) onto card 0: move to the front
     
       | 12 : (spot_at(C::OnCard, 3), true, false)
       | 13 : (spot_at(C::OnCard, 0), false, true)
       -- 14-15 drag card 0 (Drill) onto End: move last
     
       | 14 : (spot_at(C::OnCard, 0), true, false)
       | 15 : (spot_at(C::OnZone, C::END_ZONE), false, true)
       -- 16-17 click card 1 (Inspect): cancel it
     
       | 16 : (spot_at(C::OnCard, 1), true, false)
       | 17 : (spot_at(C::OnCard, 1), false, true)
       -- 18-19 drag the Paint button onto Trash: cancel every Paint
     
       | 18 : (spot_at(C::OnTool, 1), true, false)
       | 19 : (spot_at(C::OnZone, C::TRASH_ZONE), false, true)
       -- 20-22 press card 0, leave it, come back, release: abandoned
     
       | 20 : (spot_at(C::OnCard, 0), true, false)
       | 21 : (spot_at(C::OnZone, C::END_ZONE), false, false)
       | 22 : (spot_at(C::OnCard, 0), false, true)
       -- 23-24 click Step: Pack starts, one unit of work done
     
       | 23 : (spot_at(C::OnControl, C::STEP), true, false)
       | 24 : (spot_at(C::OnControl, C::STEP), false, true)
       | _ : (C::NOWHERE, false, false));
    #pragma diagram {"xy":"H0;V0","wh":"90000;50000"} #end)
}

function pacing_script (c: uint64;)
  returns (place: C::spot;
           pressed: bool;
           released: bool;)
{
  diagram
    (let place, pressed, released = (case c of
       | 1 : (spot_at(C::OnControl, C::FILL), true, false)
       | 2 : (spot_at(C::OnControl, C::FILL), false, true)
       | _ : (C::NOWHERE, false, false));
    #pragma diagram {"xy":"H0;V0","wh":"80000;9797"} #end)
}

function focus_script (c: uint64;)
  returns (place: C::spot;
           pressed: bool;
           released: bool;
           hovered_cell: uint32;)
{
  diagram
    (let place, pressed, released, hovered_cell = (case c of
       -- 1-8 click Pause, then Paint, Pack, Drill
     
       | 1 : (spot_at(C::OnControl, C::PAUSE), true, false, C::NONE)
       | 2 : (spot_at(C::OnControl, C::PAUSE), false, true, C::NONE)
       | 3 : (spot_at(C::OnTool, 1), true, false, C::NONE)
       | 4 : (spot_at(C::OnTool, 1), false, true, C::NONE)
       | 5 : (spot_at(C::OnTool, 2), true, false, C::NONE)
       | 6 : (spot_at(C::OnTool, 2), false, true, C::NONE)
       | 7 : (spot_at(C::OnTool, 3), true, false, C::NONE)
       | 8 : (spot_at(C::OnTool, 3), false, true, C::NONE)
       -- 9 over memory cell 1; 10 over card 2; 11 over memory cell 3
     
       | 9 : (C::NOWHERE, false, false, 1)
       | 10 : (spot_at(C::OnCard, 2), false, false, C::NONE)
       | 11 : (C::NOWHERE, false, false, 3)
       | _ : (C::NOWHERE, false, false, C::NONE));
    #pragma diagram {"xy":"H0;V0","wh":"90000;30000"} #end)
}

function card_edges (cards: V::card ^ V::CARDS;
                     over: C::spot;
                     held: C::spot;
                     grabbed: V::card;)
  returns (edges: int32 ^ V::CARDS;)
{
  diagram
    (let edges = (mapi (C::card_edge \ over: over, held: held, grabbed: grabbed)) <<V::CARDS>> (cards);
     
    #pragma diagram {"xy":"H3000;V509","wh":"96000;4219"} #end)
}

function cell_hover_on (hovered: uint32;)
  returns (cell_hover: bool ^ V::PAGE;)
{
  diagram
    (let cell_hover = (mapi (cell_is \ hovered: hovered)) <<V::PAGE>> ();
     
    #pragma diagram {"xy":"H4000;V509","wh":"68000;4219"} #end)
}

function length_value (queue_length: L::index;)
  returns (value: float32;)
{
  diagram
    (let value = (queue_length :> float32);
    #pragma diagram {"xy":"H0;V0","wh":"40000;3200"} #end)
}

node latch_status (command_status: Q::command_result;)
  returns (status: Q::command_result;)
{
  diagram
    (let status = 
         Q::NoCommand -> 
         (if command_status = Q::NoCommand 
             then pre status 
             else command_status);
    #pragma diagram {"xy":"H-23125;V-12301","wh":"40000;9797"} #end)
}

node latch_text (command: Q::command;
                 text: char ^ C::TEXT;)
  returns (last_text: char ^ C::TEXT;)
{
  diagram
    (let last_text = C::EMPTY_TEXT -> (if command = Q::Wait {} then pre last_text else text);
    #pragma diagram {"xy":"H0;V0","wh":"90000;3200"} #end)
}

