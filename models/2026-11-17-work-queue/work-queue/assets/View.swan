-- version swan: 2027.0 graph: 2.1
use JobList as L;

use Job as Job;

use WorkQueue as Q;

const PAGE: uint32 = 64;

const CARDS: uint32 = 8;

const STRIP: uint32 = 64;

type link = NoLink {} | ToSlot {slot: L::index};

type slot_view = {
  used: bool,
  operation: Job::operation,
  version: L::version,
  next: link,
  prev: link,
  is_head: bool,
  is_tail: bool,
  is_free_head: bool
};

type card = {
  present: bool,
  item: L::ref,
  slot: int32,
  operation: Job::operation,
  duration_cycles: uint32
};

type gesture =
  NoGesture {}
  | NewCard {operation: Job::operation, gap: uint32}
  | DragCard {card: uint32, gap: uint32}
  | DeleteCard {card: uint32}
  | CancelOperation {operation: Job::operation};

const NO_SLOT: int32 = -1;

const NO_JOB: Job::t = {operation: Job::Production, duration_cycles: 0}: Job::t;

const FREE_VIEW: slot_view = {used: false, operation: Job::Production, version: 0,
  next: NoLink {}, prev: NoLink {}, is_head: false, is_tail: false,
  is_free_head: false}: slot_view;

const NO_CARD: card = {present: false, item: L::Null {}, slot: NO_SLOT,
  operation: Job::Production, duration_cycles: 0}: card;

const NO_OPERATION: Job::operation = Job::Production;

function card_operation (c: card;)
  returns (operation: Job::operation;)
{
  diagram
    (let operation = if c.present then c.operation else NO_OPERATION;
    #pragma diagram {"xy":"H0;V0","wh":"58000;3200"} #end)
}

inline function link_of (r: L::ref;)
  returns (target: link;)
{
  diagram
    (activate #0 when r match
       | L::Null :
         {
           diagram
             (let target = NoLink {};
             #pragma diagram {"xy":"h-11000;v0","wh":"24000;3200"} #end)
         #pragma diagram {"xy":"h0;v-2091","wh":"50000;7200"} #end
         }
       | L::Ref {position} :
         {
           diagram
             (let target = ToSlot {slot: position.idx};
             #pragma diagram {"xy":"h0;v0","wh":"46000;3200"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"50000;7200"} #end
         }
     #pragma diagram {"xy":"H0;V0","wh":"50000;24819"} #end)
}

inline function slot_number (r: L::ref;)
  returns (slot: int32;)
{
  diagram
    (activate #0 when r match
       | L::Null :
         {
           diagram
             (let slot = NO_SLOT;
             #pragma diagram {"xy":"h-7000;v0","wh":"18000;3200"} #end)
         #pragma diagram {"xy":"h0;v-2091","wh":"42000;7200"} #end
         }
       | L::Ref {position} :
         {
           diagram
             (let slot = (position.idx :> int32);
             #pragma diagram {"xy":"h0;v0","wh":"38000;3200"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"42000;7200"} #end
         }
     #pragma diagram {"xy":"H0;V0","wh":"42000;24819"} #end)
}

inline function is_slot (r: L::ref;
                         idx: L::index;)
  returns (matches: bool;)
{
  diagram
    (let matches = link_of(r) = ToSlot {slot: idx};
    #pragma diagram {"xy":"H0;V0","wh":"48000;3200"} #end)
}

inline function view_slot (i: uint32;
                           l: L::list;
                           first: L::index;)
  returns (view: slot_view;)
{
  diagram
    (let
       idx = first + i;
       info = L::slot_info(l, idx);
       view = {used: info.used, operation: if info.used then info.value.operation else Job::Production,
         version: info.version, next: link_of(info.next), prev: link_of(info.prev),
         is_head: info.used and is_slot(L::front(l), idx),
         is_tail: info.used and is_slot(L::back(l), idx),
         is_free_head: not info.used and is_slot(L::free_front(l), idx)}: slot_view;
    #pragma diagram {"xy":"H0;V0","wh":"96000;15376"} #end)
    
    (var
        idx: L::index;
        info: L::slot_state;)
}

function page_view (l: L::list;
                    page: uint32;)
  returns (slots: slot_view ^ PAGE;)
{
  diagram
    (let
       first = page * PAGE;
       slots = (mapi (view_slot \ l: l, first: first)) <<PAGE>> ();
    #pragma diagram {"xy":"H0;V0","wh":"66000;6078"} #end)
    
    (var
        first: L::index;)
}

inline function card_of (job: Job::t;
                         r: L::ref;)
  returns (view: card;)
{
  diagram
    (let view = {present: r <> L::null(), item: r, slot: slot_number(r),
       operation: job.operation, duration_cycles: job.duration_cycles}: card;
    #pragma diagram {"xy":"H0;V0","wh":"72000;4219"} #end)
}

function queue_view (l: L::list;)
  returns (cards: card ^ CARDS;)
{
  diagram
    (let
       jobs, refs, _ = L::copy_front <<CARDS>> (l, NO_JOB);
       cards = (map card_of) <<CARDS>> (jobs, refs);
    #pragma diagram {"xy":"H0;V0","wh":"58000;6078"} #end)
    
    (var
        jobs: Job::t ^ CARDS;
        refs: L::ref ^ CARDS;)
}

inline function count_used (i: uint32;
                            count: uint32;
                            l: L::list;
                            first: L::index;)
  returns (total: uint32;)
{
  diagram
    (let total = if L::slot_info(l, first + i).used then count + 1 else count;
    #pragma diagram {"xy":"H0;V0","wh":"76000;3200"} #end)
}

inline function cell_fill (cell: uint32;
                           l: L::list;)
  returns (percent: uint32;)
{
  diagram
    (let
       first = (cell * L::N) / STRIP;
       end_slot = ((cell + 1) * L::N) / STRIP;
       covered = end_slot - first;
       percent = if covered = 0 then 0 else (100 * used) / covered;
    #pragma diagram {"xy":"H0;V0","wh":"64000;17235"} #end)
    (#2 expr forward
      <<L::N>> with <<j>>
      diagram
        (#3 block count_used
        #pragma diagram {"xy":"h-8050;v29400","wh":"20000;14000"} #end)
        (#4 expr j
        #pragma diagram {"xy":"h-38550;v35050"} #end)
        (#5 expr last 'total
        #pragma diagram {"xy":"h-42550;v23950","wh":"16000;3200"} #end)
        (#6 expr l
        #pragma diagram {"xy":"h-38550;v27650"} #end)
        (#7 expr first
        #pragma diagram {"xy":"h-39550;v31350","wh":"10000;3200"} #end)
        (#8 def total
        #pragma diagram {"xy":"h23450;v29400","wh":"10000;3200"} #end)
        
        (#9 wire #4 => #3 .(i))
        (#10 wire #5 => #3 .(count))
        (#11 wire #6 => #3 .(l))
        (#12 wire #7 => #3 .(first))
        (#13 wire #3 .(total) => #8
        #pragma diagram {"wp":"v0|#3 #8"} #end)
      until j + 1 >= covered
      returns (total: last = 0)
    #pragma diagram {"xy":"H-8050;V29400","wh":"56600;30000"} #end)
    (#14 def used
    #pragma diagram {"xy":"H40750;V29400"} #end)
    
    (#15 wire #2 .(2) => #14
    #pragma diagram {"wp":"v0|#2 #14"} #end)
    
    (var
        first: L::index;
        end_slot: L::index;
        covered: uint32;
        used: uint32;)
}

function occupancy (l: L::list;)
  returns (cells: uint32 ^ STRIP;)
{
  diagram
    (let cells = (mapi (cell_fill \ l: l)) <<STRIP>> ();
    #pragma diagram {"xy":"H0;V0","wh":"52000;3200"} #end)
}

inline function gap_target (cards: card ^ CARDS;
                            gap: uint32;)
  returns (target: L::ref;)
{
  diagram
    (let target = (cards .[gap] default NO_CARD).item;
    #pragma diagram {"xy":"H0;V0","wh":"50000;3200"} #end)
}

function decode (cards: card ^ CARDS;
                 action: gesture;)
  returns (request: Q::command;)
{
  diagram
    (activate #0 when action match
       | NoGesture :
         {
           diagram
             (let request = Q::Wait {};
             #pragma diagram {"xy":"h-26000;v0","wh":"28000;3200"} #end)
         #pragma diagram {"xy":"h0;v-20389","wh":"84000;7200"} #end
         }
       | NewCard {added} :
         {
           diagram
             (let request = Q::InsertBefore {target: gap_target(cards, added.gap),
                job: Job::make(added.operation)};
             #pragma diagram {"xy":"h-6000;v0","wh":"68000;4219"} #end)
         #pragma diagram {"xy":"h0;v-8980","wh":"84000;8219"} #end
         }
       | DragCard {dragged} :
         {
           diagram
             (let request = Q::Move {
                item: (cards .[dragged.card] default NO_CARD).item,
                before: gap_target(cards, dragged.gap)};
             #pragma diagram {"xy":"h-13000;v0","wh":"54000;6078"} #end)
         #pragma diagram {"xy":"h0;v3869","wh":"84000;10078"} #end
         }
       | DeleteCard {deleted} :
         {
           diagram
             (let request = Q::Cancel {target: (cards .[deleted.card] default NO_CARD).item};
             #pragma diagram {"xy":"h0;v0","wh":"80000;3200"} #end)
         #pragma diagram {"xy":"h0;v16208","wh":"84000;7200"} #end
         }
       | CancelOperation {selected} :
         {
           diagram
             (let request = Q::CancelType {operation: selected.operation};
             #pragma diagram {"xy":"h-9000;v0","wh":"62000;3200"} #end)
         #pragma diagram {"xy":"h0;v27108","wh":"84000;7200"} #end
         }
     #pragma diagram {"xy":"H0;V0","wh":"84000;61416"} #end)
}

function paced_advance (l_in * : L::list;
                        previous: Q::work;
                        run: bool;)
  returns (l_out at l_in: L::list;
           current: Q::work;)
{
  diagram
    (activate #0
       if run
       then
         {
           diagram
             (let l_out, current = Q::advance(l_in, previous);
             #pragma diagram {"xy":"h0;v0","wh":"50000;3200"} #end)
         #pragma diagram {"xy":"h0;v-3520","wh":"54000;7200"} #end
         }
       else
         {
           diagram
             (let l_out = !l_in; current = previous;
             #pragma diagram {"xy":"h-5000;v0","wh":"40000;3200"} #end)
         #pragma diagram {"xy":"h0;v7380","wh":"54000;7200"} #end
         }
     #pragma diagram {"xy":"H0;V0","wh":"54000;21960"} #end)
}

