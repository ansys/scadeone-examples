    (#49 wire #12 .(status) => #14
    #pragma diagram {"wp":"v2700|#12 h6500 v17200 #14"} #end)
    (#50 wire #15 .(l_out) => #16
    #pragma diagram {"wp":"v-2300|#15 #16"} #end)
    (#51 wire #15 .(status) => #17
    #pragma diagram {"wp":"v1400|#15 #17"} #end)
    (#52 wire #18 => #19 .(request))
    (#53 wire #19 .(l_out) => #20, #74
    #pragma diagram {"wp":"v-2600|#19 h14500[#20, v-3700 #74]"} #end)
    (#54 wire #19 .(status) => #21
    #pragma diagram {"wp":"v2367|#19 h6167 v2433 #21"} #end)
    (#55 wire #19 .(accepted) => #22
    #pragma diagram {"wp":"v1100|#19 #22"} #end)
    (#56 wire #23 .(l_out) => #24
    #pragma diagram {"wp":"v2000|#23 #24"} #end)
    (#57 wire #23 .(current) => #25
    #pragma diagram {"wp":"v-2000|#23 #25"} #end)
    (#58 wire #26 => #27 .(request))
    (#59 wire #27 .(l_out) => #28
    #pragma diagram {"wp":"v2000|#27 #28"} #end)
    (#60 wire #27 .(status) => #29
    #pragma diagram {"wp":"v-2000|#27 #29"} #end)
    (#81 wire #61 => #5 .(l_in))
    (#83 wire #63 => #8 .(l_in))
    (#85 wire #65 => #12 .(l_in))
    (#87 wire #67 => #15 .(l_in))
    (#89 wire #69 => #19 .(l_in))
    (#91 wire #71 => #27 .(l_in))
    (#93 wire #73 => #23 .(l_in))
    (assert
     $capacity: L::size(full) = L::N and L::free_front(full) = L::null();
     $full_rejected: full_status = Q::QueueFull and rejected = full;
     $remove_all_matching:
       cancel_status = Q::Accepted and L::size(half) = L::N / 2
       and L::front(half) = L::Ref {idx: 1, version: 0}
       and L::back(half) = L::Ref {idx: L::N - 1, version: 0}
       and all_survivors_linked(half);
     $no_match_unchanged: no_match_status = Q::Accepted and no_match = half;
     $freed_slot_reused:
       recycle_status = Q::Accepted and L::size(recycled) = L::N / 2 + 1
       and recycled_handle = L::Ref {idx: L::N - 2, version: 1}
       and L::front(recycled) = recycled_handle
       and L::slot_info(recycled, L::N - 2).next = L::Ref {idx: 1, version: 0};
     $urgent_dispatch:
       current = Q::Working {job: ONE_CYCLE_DRILL, remaining_cycles: 1}
       and L::size(dispatched) = L::N / 2;
     $cancel_every_remaining_job:
       clear_status = Q::Accepted and L::size(cleared) = 0
       and L::front(cleared) = L::null() and L::back(cleared) = L::null();
    #pragma diagram {"xy":"H-2500;V-74050","wh":"90000;40000"} #end)
    
    (var
        full: L::list;
        rejected: L::list;
        full_status: Q::command_result;
        half: L::list;
        cancel_status: Q::command_result;
        no_match: L::list;
        no_match_status: Q::command_result;
        recycled: L::list;
        recycle_status: Q::command_result;
        recycled_handle: L::ref;
        dispatched: L::list;
        current: Q::work;
        cleared: L::list;
        clear_status: Q::command_result;)
}

-- Panel gestures decoded against the cards shown at the previous cycle
-- (see gesture_script):
--   1 new Inspect, runs at once      5 drag Pack to the front
--   2 new Paint, appended            6 drag Pack back to the end
--   3 new Pack, appended             7 delete Drill: slot 2 freed
--   4 new Drill between them         8 new Rework: reuses slot 2 (version 1)
--   9 Inspect ends, Paint starts
-- The panel runs in interactive mode, every cycle, on the first memory page;
-- the gestures are decoded against the cards shown at the previous cycle
-- (the `pre` feedback of `cards`).

_harness panel_gestures
{
  diagram
    (#0 expr _current_cycle
    #pragma diagram {"xy":"H-80000;V0","wh":"16000;3200"} #end)
    (#1 expr #2 >= #90001
      where
        (#2 group)
        (#90001 group)
    #pragma diagram {"xy":"H-42500;V17100"} #end)
    (#90002 expr GESTURE_CYCLES
    #pragma diagram {"xy":"H-82000;V19000","wh":"20000;3200"} #end)
    (#90003 wire #90002 => #90001)
    (#3 def _stop_condition
    #pragma diagram {"xy":"H-13000;V17100","wh":"16000;3200"} #end)
    (#4 def c
    #pragma diagram {"xy":"H-41500;V-5100"} #end)
    (#5 block gesture_script
    #pragma diagram {"xy":"H-46500;V0","wh":"18000;6000"} #end)
    (#6 def action
    #pragma diagram {"xy":"H-10000;V0","wh":"10000;3200"} #end)
    (#90004 expr V::NO_CARD ^ V::CARDS
    #pragma diagram {"xy":"H21500;V-32150","wh":"20000;3200"} #end)
    (#7 expr #90005 pre #8
      where
        (#90005 group)
        (#8 group)
    #pragma diagram {"xy":"H72000;V-30250"} #end)
    (#90006 wire #90004 => #90005)
    (#9 def shown
    #pragma diagram {"xy":"H99500;V-30250","wh":"10000;3200"} #end)
    (#10 block V::decode
    #pragma diagram {"xy":"H-13000;V-8100","wh":"16000;8000"} #end)
    (#11 expr false
    #pragma diagram {"xy":"H-10000;V13400","wh":"10000;3200"} #end)
    (#12 expr true
    #pragma diagram {"xy":"H-9000;V3700"} #end)
    (#13 expr FIRST_PAGE
    #pragma diagram {"xy":"H-11000;V7400","wh":"12000;3200"} #end)
    (#14 block V::panel
    #pragma diagram {"xy":"H21500;V4400","wh":"20000;24000"} #end)
    (#15 def current
    #pragma diagram {"xy":"H73000;V-4500","wh":"10000;3200"} #end)
    (#16 def queue_length
    #pragma diagram {"xy":"H71000;V-800","wh":"14000;3200"} #end)
    (#17 def command_status
    #pragma diagram {"xy":"H70000;V10300","wh":"16000;3200"} #end)
    (#18 def accepted
    #pragma diagram {"xy":"H73000;V2900","wh":"10000;3200"} #end)
    (#19 def cards
    #pragma diagram {"xy":"H73000;V-24650","wh":"10000;3200"} #end)
    (#20 def slots
    #pragma diagram {"xy":"H73000;V14000","wh":"10000;3200"} #end)
    (#21 def cells
    #pragma diagram {"xy":"H73000;V17700","wh":"10000;3200"} #end)
    (#22 def capacity
    #pragma diagram {"xy":"H73000;V6600","wh":"10000;3200"} #end)
    (#23 block (map V::card_operation) <<V::CARDS>>
    #pragma diagram {"xy":"H63000;V-15575","wh":"30000;13950"} #end)
    (#24 def ops
    #pragma diagram {"xy":"H100500;V-13588"} #end)
    
    (#30 wire #0 => #2, #4, #5 .(c)
    #pragma diagram {"wp":"#0 h9750[v15200 #2, v-5100 #4, #5]"} #end)
    (#31 wire #1 => #3)
    (#32 wire #5 .(action) => #6, #10 .(action)
    #pragma diagram {"wp":"v0|#5 h7750[#6, v-7600 #10]"} #end)
    (#33 wire #7 => #9, #10 .(cards)
    #pragma diagram {"wp":"#7 h9750[#9, v-12913 h-115000 v34563 #10]"} #end)
    (#34 wire #10 .(request) => #14 .(command)
    #pragma diagram {"wp":"v2250|#10 #14"} #end)
    (#35 wire #11 => #14 .(scripted))
    (#36 wire #12 => #14 .(run))
    (#37 wire #13 => #14 .(page))
    (#38 wire #14 .(current) => #15
    #pragma diagram {"wp":"v-8900|#14 #15"} #end)
    (#39 wire #14 .(queue_length) => #16
    #pragma diagram {"wp":"v-5200|#14 #16"} #end)
    (#40 wire #14 .(command_status) => #17
    #pragma diagram {"wp":"v5900|#14 #17"} #end)
    (#41 wire #14 .(accepted) => #18
    #pragma diagram {"wp":"v-1500|#14 #18"} #end)
    (#42 wire #14 .(cards) => #19, #8, #23 .(1)
    #pragma diagram {"wp":"v-10500|#14 h2100 v-50 v-7438[v-11062[#19, v-3700 #8], #23]"} #end)
    (#43 wire #14 .(slots) => #20
    #pragma diagram {"wp":"v9600|#14 #20"} #end)
    (#44 wire #14 .(cells) => #21
    #pragma diagram {"wp":"v11300|#14 h31500 v2000 #21"} #end)
    (#45 wire #14 .(capacity) => #22
    #pragma diagram {"wp":"v2200|#14 #22"} #end)
    (#46 wire #23 .(1) => #24
    #pragma diagram {"wp":"v-0|#23 #24"} #end)
    (assert
     $statuses: command_status = (if c = GESTURE_CYCLES then Q::NoCommand else Q::Accepted);
     $capacity_shown: capacity = L::N;
     $inspect_runs: c > INSPECT_CYCLES
       or current = Q::Working {job: Job::make(Job::Inspect), remaining_cycles:
         (INSPECT_CYCLES + 1 - c :> uint32)};
     $head_starts_next: c <> GESTURE_CYCLES
       or (current = Q::Working {job: Job::make(Job::Paint), remaining_cycles: PAINT_CYCLES}
           and ops = [Job::Rework, Job::Pack] @ (V::NO_OPERATION ^ 6));
     $append: c <> 3
       or ops = [Job::Paint, Job::Pack] @ (V::NO_OPERATION ^ 6);
     $drop_between: c <> 4
       or ops = [Job::Paint, Job::Drill, Job::Pack] @ (V::NO_OPERATION ^ 5);
     $drag_to_front: c <> 5
       or ops = [Job::Pack, Job::Paint, Job::Drill] @ (V::NO_OPERATION ^ 5);
     $drag_to_end: c <> 6
       or ops = [Job::Paint, Job::Drill, Job::Pack] @ (V::NO_OPERATION ^ 5);
     $delete: c <> 7
       or (ops = [Job::Paint, Job::Pack] @ (V::NO_OPERATION ^ 6)
           and queue_length = 2);
     $freed_slot_reused: c <> 8
       or (ops = [Job::Paint, Job::Rework, Job::Pack] @ (V::NO_OPERATION ^ 5)
           and accepted = L::Ref {idx: 2, version: 1}
           and cards[1].slot = 2);
     $moves_keep_slots: c <> 6
       or (cards[0].slot = 0 and cards[1].slot = 2 and cards[2].slot = 1
           and cards[0].item = L::Ref {idx: 0, version: 1});
     $memory_grid: c <> 8
       or (slots[0].used and slots[0].operation = Job::Paint and slots[0].is_head
           and slots[0].version = 1 and slots[0].next = V::ToSlot {slot: 2}
           and slots[0].prev = V::NoLink {} and slots[2].prev = V::ToSlot {slot: 0}
           and slots[2].operation = Job::Rework and slots[2].version = 1 and slots[2].next = V::ToSlot {slot: 1}
           and slots[1].is_tail and slots[1].next = V::NoLink {}
           and slots[3].is_free_head and not slots[3].used and slots[3].next = V::ToSlot {slot: 4});
     -- three used slots (0, 1, 2)

     $overview: c <> 8
       or (if L::N = V::STRIP
           then cells[0] = FULL_CELL and cells[1] = FULL_CELL and cells[2] = FULL_CELL
             and cells[3] = 0
           else cells[0] = (3 * FULL_CELL * V::STRIP) / L::N and cells[1] = 0);
    #pragma diagram {"xy":"H9250;V-82576","wh":"90000;60000"} #end)
    
    (var
        c: uint64;
        action: V::gesture;
        shown: V::card ^ V::CARDS;
        current: Q::work;
        queue_length: L::index;
        command_status: Q::command_result;
        accepted: L::ref;
        cards: V::card ^ V::CARDS;
        slots: V::slot_view ^ V::PAGE;
        cells: uint32 ^ V::STRIP;
        capacity: L::index;
        ops: Job::operation ^ V::CARDS;)
}

-- The panel's scripted mode, running every cycle, reproduces the storyline.
-- In scripted mode the panel ignores its `command` input.

_harness panel_scripted
{
  diagram
    (#0 expr _current_cycle
    #pragma diagram {"xy":"H-80000;V0","wh":"16000;3200"} #end)
    (#1 expr #2 >= #90001
      where
        (#2 group)
        (#90001 group)
    #pragma diagram {"xy":"H-42500;V1900"} #end)
    (#90002 expr (STORY :> uint64)
    #pragma diagram {"xy":"H-82000;V3800","wh":"20000;3200"} #end)
    (#90003 wire #90002 => #90001)
    (#3 def _stop_condition
    #pragma diagram {"xy":"H-13000;V1900","wh":"16000;3200"} #end)
    (#4 expr true
    #pragma diagram {"xy":"H-112500;V-23200"} #end)
    (#5 expr Q::Wait {}
    #pragma diagram {"xy":"H-114500;V-17200","wh":"12000;3200"} #end)
    (#6 expr FIRST_PAGE
    #pragma diagram {"xy":"H-114500;V-35200","wh":"12000;3200"} #end)
    (#7 block V::panel
    #pragma diagram {"xy":"H-82000;V-26200","wh":"20000;24000"} #end)
    (#8 def current
    #pragma diagram {"xy":"H-42500;V-32200","wh":"10000;3200"} #end)
    (#9 def queue_length
    #pragma diagram {"xy":"H-44500;V-28200","wh":"14000;3200"} #end)
    (#10 def command_status
    #pragma diagram {"xy":"H-45500;V-20200","wh":"16000;3200"} #end)
    (#11 def accepted
    #pragma diagram {"xy":"H-42500;V-24200","wh":"10000;3200"} #end)
    (#12 def cards
    #pragma diagram {"xy":"H-42500;V-36200","wh":"10000;3200"} #end)
    (#13 block trace_ok
    #pragma diagram {"xy":"H-46500;V-11100","wh":"18000;14000"} #end)
    (#14 def status_ok
    #pragma diagram {"xy":"H-11000;V-3700","wh":"12000;3200"} #end)
    (#15 def accepted_ok
    #pragma diagram {"xy":"H-11000;V-18500","wh":"12000;3200"} #end)
    (#16 def operation_ok
    #pragma diagram {"xy":"H-11000;V-14800","wh":"12000;3200"} #end)
    (#17 def remaining_ok
    #pragma diagram {"xy":"H-11000;V-11100","wh":"12000;3200"} #end)
    (#18 def length_ok
    #pragma diagram {"xy":"H-11000;V-7400","wh":"12000;3200"} #end)
    
    (#30 wire #0 => #2, #13 .(cycle)
    #pragma diagram {"wp":"#0 h9750[#2, v-8150 #13]"} #end)
    (#31 wire #1 => #3)
    (#32 wire #4 => #7 .(scripted), #7 .(run)
    #pragma diagram {"wp":"#4 h3250[#7, v1733 #7]"} #end)
    (#33 wire #5 => #7 .(command))
    (#34 wire #6 => #7 .(page))
    (#35 wire #7 .(current) => #8
    #pragma diagram {"wp":"v-6000|#7 #8"} #end)
    (#900 wire #7 .(current:, queue_length:, command_status:, accepted:) => #13 .(current: current, queue_length: queue_length, status: command_status, accepted: accepted)
    #pragma diagram {"wp":"v10050|#7 #13"} #end)
    (#36 wire #7 .(queue_length) => #9
    #pragma diagram {"wp":"v-2000|#7 #9"} #end)
    (#37 wire #7 .(command_status) => #10
    #pragma diagram {"wp":"v6000|#7 #10"} #end)
    (#38 wire #7 .(accepted) => #11
    #pragma diagram {"wp":"v2000|#7 #11"} #end)
    (#39 wire #7 .(cards) => #12
    #pragma diagram {"wp":"v-10000|#7 #12"} #end)
    (#40 wire #13 .(status_ok) => #14
    #pragma diagram {"wp":"v5233|#13 h17500 v2167 #14"} #end)
    (#41 wire #13 .(accepted_ok) => #15
    #pragma diagram {"wp":"v-5233|#13 h15500 v-2167 #15"} #end)
    (#42 wire #13 .(operation_ok) => #16
    #pragma diagram {"wp":"v-3700|#13 #16"} #end)
    (#43 wire #13 .(remaining_ok) => #17
    #pragma diagram {"wp":"v0|#13 #17"} #end)
    (#44 wire #13 .(length_ok) => #18
    #pragma diagram {"wp":"v3700|#13 #18"} #end)
    (assert
     $command_status: status_ok;
     $accepted_handle: accepted_ok;
     $running_operation: operation_ok;
     $remaining_cycles: remaining_ok;
     $pending_queue_length: length_ok;
     $cards_match_length: (cards .[queue_length] default V::NO_CARD).present = false
       and (queue_length = 0 or cards[0].present);
    #pragma diagram {"xy":"H-60750;V-56600","wh":"80000;16000"} #end)
    
    (var
        current: Q::work;
        queue_length: L::index;
        command_status: Q::command_result;
        accepted: L::ref;
        cards: V::card ^ V::CARDS;
        status_ok: bool;
        accepted_ok: bool;
        operation_ok: bool;
        remaining_ok: bool;
        length_ok: bool;)
}
