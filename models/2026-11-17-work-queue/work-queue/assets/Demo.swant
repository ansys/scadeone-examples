    (assert
     $command_status: status_ok;
     $accepted_handle: accepted_ok;
     $running_operation: operation_ok;
     $remaining_cycles: remaining_ok;
     $pending_queue_length: length_ok;
     $cards_match_length: (cards .[queue_length] default V::NO_CARD).present = false
       and (queue_length = 0 or cards[0].present);
    #pragma diagram {"xy":"H-63750;V-67000","wh":"80000;16000"} #end)
