_harness bulk_cancellation
{
  diagram
    (#7 expr (!full, Q::Add {job: ONE_CYCLE_PACK})
    #pragma diagram {"xy":"H-44250;V-950","wh":"40000;3200"} #end)
    (#8 block Q::apply
    #pragma swt under_test #end
    #pragma diagram {"xy":"H-9750;V1050","wh":"16000;8000"} #end)
    (#9 def rejected, full_status, _
    #pragma diagram {"xy":"H18750;V1050","wh":"28000;3200"} #end)
    (#12 block Q::apply
    #pragma swt under_test #end
    #pragma diagram {"xy":"H-9750;V14950","wh":"16000;8000"} #end)
    (#13 def half, cancel_status, _
    #pragma diagram {"xy":"H15950;V13950","wh":"26000;3200"} #end)
    (#23 block Q::start_next
    #pragma swt under_test #end
    #pragma diagram {"xy":"H-6512;V84150","wh":"16000;8000"} #end)
    (#24 def dispatched, current
    #pragma diagram {"xy":"H28988;V86150","wh":"22000;3200"} #end)
    (assert
     $capacity: L::size(full) = L::N and L::free_front(full) = L::null();
     $full_rejected: full_status = Q::QueueFull and rejected = full;
     $remove_all_matching:
       cancel_status = Q::Accepted and L::size(half) = L::N / 2
       and L::front(half) = L::Ref {idx: 1, version: 0}
       and L::back(half) = L::Ref {idx: L::N - 1, version: 0}
       and all_survivors_linked(half);
     $no_match_unchanged: no_match_status = Q::Accepted and no_match = half;
     $freed_slot_reused:
       recycle_status = Q::Accepted and L::size(recycled) = L::N / 2 + 1
       and recycled_handle = L::Ref {idx: L::N - 2, version: 1}
       and L::front(recycled) = recycled_handle
       and L::slot_info(recycled, L::N - 2).next = L::Ref {idx: 1, version: 0};
     $urgent_dispatch:
       current = Q::Working {job: ONE_CYCLE_DRILL, remaining_cycles: 1}
       and L::size(dispatched) = L::N / 2;
     $cancel_every_remaining_job:
       clear_status = Q::Accepted and L::size(cleared) = 0
       and L::front(cleared) = L::null() and L::back(cleared) = L::null();
    #pragma diagram {"xy":"H145975;V30950","wh":"90000;40000"} #end)
    (#0 expr (!full, cancel_paint)
    #pragma diagram {"xy":"H-43012;V14950","wh":"24000;3200"} #end)
    (#1 expr !recycled
    #pragma diagram {"xy":"H-27037;V86150","wh":"14000;3200"} #end)
    (let 
         _stop_condition = _current_cycle >= ONE_SHOT;
         full = fill(!L::init()); -- Creates a full list
         cancel_paint = Q::CancelType {operation: Job::Paint};
         
    #pragma diagram {"xy":"H-9750;V-20149","wh":"58000;9797"} #end)
    
    (#44 wire #7 => #8)
    (#45 wire #8 => #9
    #pragma diagram {"wp":"v0|#8 #9"} #end)
    (#48 wire #12 => #13
    #pragma diagram {"wp":"v-1000|#12 #13"} #end)
    (#56 wire #23 => #24
    #pragma diagram {"wp":"v2000|#23 #24"} #end)
    (#3 wire #0 => #12)
    (#4 wire #1 => #23)
    
    (var
        full: L::list;
        rejected: L::list;
        full_status: Q::command_result;
        half: L::list;
        cancel_status: Q::command_result;
        no_match: L::list;
        no_match_status: Q::command_result;
        recycled: L::list;
        recycle_status: Q::command_result;
        recycled_handle: L::ref;
        dispatched: L::list;
        current: Q::work;
        cleared: L::list;
        clear_status: Q::command_result;
        cancel_paint;)
    (diagram $OnHalf
       (#11 expr (!half, cancel_paint)
       #pragma diagram {"xy":"h-34500;v-12450","wh":"24000;3200"} #end)
       (#15 block Q::apply
       #pragma swt under_test #end
       #pragma diagram {"xy":"h-6000;v-11300","wh":"16000;8000"} #end)
       (#16 def no_match, no_match_status, _
       #pragma diagram {"xy":"h38500;v-12450","wh":"32000;3200"} #end)
       (#18 expr (!half, Q::Urgent {job: ONE_CYCLE_DRILL})
       #pragma diagram {"xy":"h-40500;v0","wh":"44000;3200"} #end)
       (#19 block Q::apply
       #pragma swt under_test #end
       #pragma diagram {"xy":"h-6000;v0","wh":"16000;8000"} #end)
       (#20 def recycled, recycle_status, recycled_handle
       #pragma diagram {"xy":"h44500;v0","wh":"44000;3200"} #end)
       (#26 expr (!half, Q::CancelType {operation: Job::Drill})
       #pragma diagram {"xy":"h-42500;v10600","wh":"48000;3200"} #end)
       (#27 block Q::apply
       #pragma swt under_test #end
       #pragma diagram {"xy":"h-6000;v10600","wh":"16000;8000"} #end)
       (#28 def cleared, clear_status, _
       #pragma diagram {"xy":"h36500;v10600","wh":"28000;3200"} #end)
       
       (#47 wire #11 => #15)
       (#50 wire #15 => #16
       #pragma diagram {"wp":"v-1150|#15 #16"} #end)
       (#52 wire #18 => #19)
       (#53 wire #19 => #20
       #pragma diagram {"wp":"v0|#19 #20"} #end)
       (#58 wire #26 => #27)
       (#59 wire #27 => #28
       #pragma diagram {"wp":"v0|#27 #28"} #end)
     #pragma diagram {"xy":"H-512;V49550","wh":"141000;45250"} #end)
}

_harness panel_gestures
{
  diagram
    (#90004 expr V::NO_CARD ^ V::CARDS 
    #pragma diagram {"xy":"H38600;V-32150","wh":"26000;3200"} #end)
    (#7 expr #90005 pre #8
      where
        (#90005 group)
        (#8 group)
    #pragma diagram {"xy":"H72000;V-30250"} #end)
    (#10 block V::decode
    #pragma diagram {"xy":"H-13000;V-8100","wh":"16000;8000"} #end)
    (#11 expr false
    #pragma diagram {"xy":"H-10000;V13400","wh":"10000;3200"} #end)
    (#12 expr true
    #pragma diagram {"xy":"H-9000;V3700"} #end)
    (#13 expr FIRST_PAGE 
    #pragma diagram {"xy":"H-9000;V7400","wh":"16000;3200"} #end)
    (#14 block V::panel
    #pragma swt under_test #end
    #pragma diagram {"xy":"H21500;V4400","wh":"20000;24000"} #end)
    (#15 def current, 
             queue_length, 
             command_status, 
             accepted, 
             cards, 
             slots, 
             cells, 
             capacity
    #pragma diagram {"xy":"H68000;V12912","wh":"20000;15376"} #end)
    (#23 block (map V::card_operation) <<V::CARDS>>
    #pragma diagram {"xy":"H64225;V-13575","wh":"30000;13950"} #end)
    (#24 def ops
    #pragma diagram {"xy":"H100500;V-13588"} #end)
    (assert
     $statuses: command_status = (if c = GESTURE_CYCLES then Q::NoCommand else Q::Accepted);
     $capacity_shown: capacity = L::N;
     $inspect_runs: c > INSPECT_CYCLES
       or current = Q::Working {job: Job::make(Job::Inspect), remaining_cycles:
         (INSPECT_CYCLES + 1 - c :> uint32)};
     $head_starts_next: c <> GESTURE_CYCLES
       or (current = Q::Working {job: Job::make(Job::Paint), remaining_cycles: PAINT_CYCLES}
           and ops = [Job::Rework, Job::Pack] @ (V::NO_OPERATION ^ 6));
     $append: c <> 3
       or ops = [Job::Paint, Job::Pack] @ (V::NO_OPERATION ^ 6);
     $drop_between: c <> 4
       or ops = [Job::Paint, Job::Drill, Job::Pack] @ (V::NO_OPERATION ^ 5);
     $drag_to_front: c <> 5
       or ops = [Job::Pack, Job::Paint, Job::Drill] @ (V::NO_OPERATION ^ 5);
     $drag_to_end: c <> 6
       or ops = [Job::Paint, Job::Drill, Job::Pack] @ (V::NO_OPERATION ^ 5);
     $delete: c <> 7
       or (ops = [Job::Paint, Job::Pack] @ (V::NO_OPERATION ^ 6)
           and queue_length = 2);
     $freed_slot_reused: c <> 8
       or (ops = [Job::Paint, Job::Rework, Job::Pack] @ (V::NO_OPERATION ^ 5)
           and accepted = L::Ref {idx: 2, version: 1}
           and cards[1].slot = 2);
     $moves_keep_slots: c <> 6
       or (cards[0].slot = 0 and cards[1].slot = 2 and cards[2].slot = 1
           and cards[0].item = L::Ref {idx: 0, version: 1});
     $memory_grid: c <> 8
       or (slots[0].used and slots[0].operation = Job::Paint and slots[0].is_head
           and slots[0].version = 1 and slots[0].next = V::ToSlot {slot: 2}
           and slots[0].prev = V::NoLink {} and slots[2].prev = V::ToSlot {slot: 0}
           and slots[2].operation = Job::Rework and slots[2].version = 1 and slots[2].next = V::ToSlot {slot: 1}
           and slots[1].is_tail and slots[1].next = V::NoLink {}
           and slots[3].is_free_head and not slots[3].used and slots[3].next = V::ToSlot {slot: 4});
     -- three used slots (0, 1, 2)
     
     $overview: c <> 8
       or (if L::N = V::STRIP
           then cells[0] = FULL_CELL and cells[1] = FULL_CELL and cells[2] = FULL_CELL
             and cells[3] = 0
           else cells[0] = (3 * FULL_CELL * V::STRIP) / L::N and cells[1] = 0);
    #pragma diagram {"xy":"H9250;V-82576","wh":"90000;60000"} #end)
    (#0 expr action
    #pragma diagram {"xy":"H-37245;V-3076","wh":"10000;3200"} #end)
    (let 
         c= _current_cycle;
         action = gesture_script(c);
         _stop_condition = c >= GESTURE_CYCLES;
    #pragma diagram {"xy":"H24462;V39448","wh":"44000;7938"} #end)
    
    (#90006 wire #90004 => #90005)
    (#33 wire #7 => #10 .(cards)
    #pragma diagram {"wp":"#7 h9750 v-12913 h-115000 v34563 #10"} #end)
    (#34 wire #10 => #14 .(command)
    #pragma diagram {"wp":"v2250|#10 #14"} #end)
    (#35 wire #11 => #14 .(scripted))
    (#36 wire #12 => #14 .(run))
    (#37 wire #13 => #14 .(page))
    (#38 wire #14 => #15
    #pragma diagram {"wp":"v8512|#14 #15"} #end)
    (#42 wire #14 .(cards) => #8, #23
    #pragma diagram {"wp":"v-4496|#14 h8862 v-11979[v-16275 #8, #23]"} #end)
    (#46 wire #23 => #24
    #pragma diagram {"wp":"v-2013|#23 #24"} #end)
    (#2 wire #0 => #10 .(action)
    #pragma diagram {"wp":"#0 h9495 v-3191 #10"} #end)
    
    (var
        c: uint64;
        action: V::gesture;
        current: Q::work;
        queue_length: L::index;
        command_status: Q::command_result;
        accepted: L::ref;
        cards: V::card ^ V::CARDS;
        slots: V::slot_view ^ V::PAGE;
        cells: uint32 ^ V::STRIP;
        capacity: L::index;
        ops: Job::operation ^ V::CARDS;)
}

_harness panel_scripted
{
  diagram
    (#0 expr _current_cycle 
    #pragma diagram {"xy":"H-53800;V0","wh":"20000;3200"} #end)
