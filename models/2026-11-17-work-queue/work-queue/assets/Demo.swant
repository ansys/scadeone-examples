    (#10 def full_status
    #pragma diagram {"xy":"H43750;V-950","wh":"14000;3200"} #end)
    (#11 expr Q::CancelType {operation: Job::Paint}
    #pragma diagram {"xy":"H-52250;V7350","wh":"36000;3200"} #end)
    (#12 block Q::apply
    #pragma diagram {"xy":"H-9750;V14950","wh":"16000;8000"} #end)
    (#13 def half
    #pragma diagram {"xy":"H46750;V12950"} #end)
    (#14 def cancel_status
    #pragma diagram {"xy":"H43750;V34850","wh":"14000;3200"} #end)
    (#15 block Q::apply
    #pragma diagram {"xy":"H75250;V7250","wh":"16000;8000"} #end)
    (#16 def no_match
    #pragma diagram {"xy":"H109750;V4950","wh":"12000;3200"} #end)
    (#17 def no_match_status
    #pragma diagram {"xy":"H107750;V8650","wh":"16000;3200"} #end)
    (#18 expr Q::Urgent {job: ONE_CYCLE_DRILL}
    #pragma diagram {"xy":"H34750;V20650","wh":"32000;3200"} #end)
    (#19 block Q::apply
    #pragma diagram {"xy":"H75250;V18650","wh":"16000;8000"} #end)
