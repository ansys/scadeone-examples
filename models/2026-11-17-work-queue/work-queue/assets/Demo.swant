_harness duration_boundaries
{
  diagram
    (#0 expr c
    #pragma diagram {"xy":"H-73900;V-8100"} #end)
    (#5 block boundary_script
    #pragma diagram {"xy":"H-46500;V-8100","wh":"18000;8000"} #end)
    (#6 def expected_status 
    #pragma diagram {"xy":"H-12800;V4500","wh":"20000;3200"} #end)
    (#7 block Q::controller
    #pragma swt under_test #end
    #pragma diagram {"xy":"H-11000;V-10100","wh":"20000;14000"} #end)
    (#9 def current, 
            queue_length, 
            command_status, 
            accepted
            
    #pragma diagram {"xy":"H27800;V-9170","wh":"20000;9797"} #end)
    (assert
     $one_cycle_job:
       c <> 1 or current = Q::Working {job: ONE_CYCLE_DRILL, remaining_cycles: 1};
     $no_idle_bubble:
       c <> 2 or current = Q::Working {job: TWO_CYCLE_PACK, remaining_cycles: 2};
     $identical_jobs_allowed:
       c <> 3 or (current = Q::Working {job: TWO_CYCLE_PACK, remaining_cycles: 1}
         and queue_length = 1 and accepted = L::Ref {idx: 0, version: 2});
     $second_identical_job_runs:
       c <> 4 or current = Q::Working {job: TWO_CYCLE_PACK, remaining_cycles: 2};
     $returns_idle:
       c < BOUNDARY_CYCLES or current = Q::Idle {};
     $public_command_result: command_status = expected_status;
    #pragma diagram {"xy":"H-5250;V-36688","wh":"78000;24673"} #end)
    (let
         c = _current_cycle;
         _stop_condition = c >= BOUNDARY_CYCLES;
    #pragma diagram {"xy":"H-12800;V17477","wh":"46000;6078"} #end)
    
    (#20 wire #0 => #5)
    (#22 wire #5 .(request) => #7 .(request)
    #pragma diagram {"wp":"v-1500|#5 #7"} #end)
    (#23 wire #5 .(expected_status) => #6
    #pragma diagram {"wp":"v1500|#5 h7350 v11100 #6"} #end)
    (#25 wire #7 => #9
    #pragma diagram {"wp":"v930|#7 #9"} #end)
    
    (var
        c: uint64;
        expected_status: Q::command_result;
        current: Q::work;
        queue_length: L::index;
        command_status: Q::command_result;
        accepted: L::ref;)
}

_harness command_validation
{
  diagram
    (let
       inspect = Job::make(Job::Inspect);
       paint = Job::make(Job::Paint);
       drill = Job::make(Job::Drill);
       _stop_condition = _current_cycle >= ONE_SHOT;
    #pragma diagram {"xy":"H-179000;V94432","wh":"50000;9797"} #end)
    (#4 expr (!L::init(), Q::Add {job: inspect})
    #pragma diagram {"xy":"H-295421;V91133","wh":"38000;3200"} #end)
    (#10 block Q::apply
    #pragma swt under_test #end
    #pragma diagram {"xy":"H-265050;V91133","wh":"16000;8000"} #end)
    (#13 def one, s0, h0
    #pragma diagram {"xy":"H-241125;V91133","wh":"16000;3200"} #end)
    (#17 block Q::apply
    #pragma swt under_test #end
    #pragma diagram {"xy":"H-265050;V102167","wh":"16000;8000"} #end)
    (assert
     $add_returns_handles: s0 = Q::Accepted and s1 = Q::Accepted
       and h0 = L::Ref {idx: 0, version: 0} and h1 = L::Ref {idx: 1, version: 0};
     $urgent_goes_first: s2 = Q::Accepted and h2 = L::Ref {idx: 2, version: 0}
       and order(front) = [Job::Drill, Job::Inspect, Job::Paint, V::NO_OPERATION];
     $insert_before: s3 = Q::Accepted
       and order(before) = [Job::Inspect, Job::Drill, Job::Paint, V::NO_OPERATION];
     $insert_after_tail: s4 = Q::Accepted
       and order(after) = [Job::Inspect, Job::Paint, Job::Drill, V::NO_OPERATION]
       and L::back(after) = h4;
     $insert_after_middle: s5 = Q::Accepted
       and order(middle) = [Job::Inspect, Job::Drill, Job::Paint, V::NO_OPERATION];
     $move_keeps_handles: s6 = Q::Accepted and h6 = L::null()
       and order(moved) = [Job::Paint, Job::Inspect, V::NO_OPERATION, V::NO_OPERATION]
       and operation_at(moved, h1) = Job::Paint and L::free_front(moved) = L::free_front(two);
     $cancel: s7 = Q::Accepted and L::size(cancelled) = 1
       and L::free_front(cancelled) = L::Ref {idx: 0, version: 1};
     $cancel_twice_rejected: s8 = Q::UnknownJob and stale = cancelled;
     $slot_reused_with_new_version: s9 = Q::Accepted and h9 = L::Ref {idx: 0, version: 1};
     $stale_handle_rejected:
       s10 = Q::UnknownJob and stale_after = reused
       and s11 = Q::UnknownJob and stale_before = reused
       and s12 = Q::UnknownJob and stale_move = reused;
     $insert_after_null_prepends: s13 = Q::Accepted
       and order(null_after) = [Job::Drill, Job::Inspect, Job::Paint, V::NO_OPERATION];
     $zero_duration_rejected: s14 = Q::InvalidDuration and zero = two and h14 = L::null();
     $wait: s15 = Q::NoCommand and waited = two;
    #pragma diagram {"xy":"H-212625;V50050","wh":"90000;50000"} #end)
    (#0 expr (!one, Q::Add {job: paint})
    #pragma diagram {"xy":"H-299421;V101900","wh":"30000;3200"} #end)
    (#1 def two, s1, h1
    #pragma diagram {"xy":"H-242750;V104567","wh":"16000;3200"} #end)
    
    (#124 wire #10 => #13
    #pragma diagram {"wp":"v0|#10 #13"} #end)
    (#2 wire #4 => #10)
    (#3 wire #0 => #17)
    (#7 wire #17 => #1
    #pragma diagram {"wp":"v2400|#17 #1"} #end)
    
    (var
        inspect: Job::t;
        paint: Job::t;
        drill: Job::t;
        one: L::list;
        two: L::list;
        front: L::list;
        before: L::list;
        after: L::list;
        middle: L::list;
