    (#30 wire #0 => #13 .(cycle))
    (#34 wire #6 => #7)
    (#900 wire #7 .(current:, 
queue_length:, 
command_status:status, 
accepted:) => #13
    #pragma diagram {"wp":"v3984|#7 h22250 v16116 #13"} #end)
    (#4 wire #7 => #3
    #pragma diagram {"wp":"v-9859|#7 #3"} #end)
    (#5 wire #13 => #1
    #pragma diagram {"wp":"v0|#13 #1"} #end)
    
    (var
        queue_length: L::index;
        cards: V::card ^ V::CARDS;
        status_ok: bool;
        accepted_ok: bool;
        operation_ok: bool;
        remaining_ok: bool;
        length_ok: bool;)
}
