        h9: L::ref;
        h14: L::ref;)
}

-- A full queue (Paint in even slots, Drill in odd slots), all in one cycle:
-- saturation, removal of every Paint job in one command, survivor links,
-- reuse of a freed slot, dispatch, removal of every remaining job.
-- Each Q::apply block works in place on a `!` copy of its input queue.
-- The diagram reads top to bottom:
--   1. adding to the full queue is rejected;
--   2. cancelling every Paint job leaves the Drill jobs of the odd slots;
--   3. on that half queue: no Paint job left, an urgent job, dispatch, clear.

_harness bulk_cancellation
{
  diagram
    (#0 expr _current_cycle
    #pragma diagram {"xy":"H-90000;V-30000","wh":"16000;3200"} #end)
    (#1 expr #2 >= #90001
      where
        (#2 group)
        (#90001 group)
    #pragma diagram {"xy":"H-60500;V-28100"} #end)
    (#90002 expr ONE_SHOT
    #pragma diagram {"xy":"H-92000;V-26200","wh":"20000;3200"} #end)
    (#90003 wire #90002 => #90001)
    (#3 def _stop_condition
    #pragma diagram {"xy":"H-31000;V-28100","wh":"16000;3200"} #end)
    (#4 expr L::init()
    #pragma diagram {"xy":"H-146750;V16950","wh":"14000;3200"} #end)
