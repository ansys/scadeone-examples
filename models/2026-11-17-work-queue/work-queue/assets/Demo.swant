    (#23 block Q::start_next
    #pragma diagram {"xy":"H140250;V12350","wh":"16000;8000"} #end)
    (#24 def dispatched
    #pragma diagram {"xy":"H170750;V14350","wh":"12000;3200"} #end)
    (#25 def current
    #pragma diagram {"xy":"H171750;V10350","wh":"10000;3200"} #end)
