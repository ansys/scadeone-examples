-- Moves `item` (currently between `previous` and `next`) to just before `before`.
-- No-op when item = before or next = before: moved onto itself, or already in place.

function relink (l_in * : list;
                 item: ref;
                 value: Item::t;
                 previous: ref;
                 next: ref;
                 before: ref;
                 new_previous: ref;)
  returns (l_out at l_in: list;
           result: move_result;)
{
  diagram
    (activate #0
       if item = before or next = before
       then
         {
           diagram
             (let l_out = !l_in; result = Moved {};
             #pragma diagram {"xy":"h-12000;v0","wh":"40000;3200"} #end)
         #pragma diagram {"xy":"h0;v-16100","wh":"68000;7200"} #end
         }
       else
         {
           diagram
             (let
                detached = set_next_of(l_in, previous, next);
                unlinked = set_prev_of(detached, next, previous);
                attached = set_next_of(unlinked, new_previous, item);
                linked = set_prev_of(attached, before, item);
                l_out = (linked with .nodes[index_of(item)].entry = Used {
                  value: value, prev: new_previous, next: before});
                result = Moved {};
             #pragma diagram {"xy":"h-1000;v-4625","wh":"62000;17000"} #end)
             
             (var
                 detached at l_in: list;
                 unlinked at detached: list;
                 attached at unlinked: list;
                 linked at attached: list;)
         #pragma diagram {"xy":"h0;v7459","wh":"68000;32200"} #end
         }
     #pragma diagram {"xy":"H1000;V-79","wh":"68000;47119"} #end)
}

