function remove_live (l_in * : list;
                      idx: index;
                      previous: ref;
                      next: ref;)
  returns (l_out at l_in: list;
           result: remove_result;)
{
  diagram
    (let
       left = set_next_of(l_in, previous, next);
       unlinked = set_prev_of(left, next, previous);
       fresh = !next_version((unlinked.nodes .[idx] default EMPTY_SLOT).version);
       l_out = (unlinked with
         .nodes[idx] = {version: fresh, entry: Free {next: unlinked.free_head}}: Slot;
         .free_head = Ref {idx: idx, version: fresh};
         .length = unlinked.length - 1);
       result = Removed {};
    #pragma diagram {"xy":"H0;V-14000","wh":"80000;19000"} #end)
    
    (var
        left at l_in: list;
        unlinked at left: list;
        fresh: version;)
}

function insert_slot (l_in * : list;
                      idx: index;
                      next_free: ref;
                      previous: ref;
                      next_node: ref;
                      value: Item::t;)
  returns (l_out at l_in: list;
           result: insert_result;)
{
  diagram
    (let
       slot_ref = !handle(l_in, idx);
       left = set_next_of(l_in, previous, slot_ref);
       linked = set_prev_of(left, next_node, slot_ref);
       l_out = (linked with
         .nodes[idx].entry = Used {value: value, prev: previous, next: next_node};
         .free_head = next_free;
         .length = linked.length + 1);
       result = Inserted {ref: slot_ref};
    #pragma diagram {"xy":"H0;V-20000","wh":"70000;20000"} #end)
    
    (var
        slot_ref: ref;
        left at l_in: list;
        linked at left: list;)
}

