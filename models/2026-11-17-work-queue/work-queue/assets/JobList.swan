-- version swan: 2027.0 graph: 2.1
-- Private storage. A slot is a free-list node or a queue node, and keeps its
-- version across Free / Used changes. Only the operators of this module see it.

type Node =
  Free {next: ref}
  | Used {value: Item::t, prev: ref, next: ref};

type Slot = {version: version, entry: Node};

type list = {
  nodes: Slot ^ N,
  head: ref,
  tail: ref,
  free_head: ref,
  length: index
};

-- Returned by read for a Null, out-of-range or stale handle.

const EMPTY_NODE: Node = Free {next: Null {}};

-- Default for an out-of-range index in `nodes .[idx] default EMPTY_SLOT`:
-- version 0, Free with no successor.

const EMPTY_SLOT: Slot = {version: 0, entry: EMPTY_NODE}: Slot;

inline function null ()
  returns (result: ref;)
{
  diagram
    (let result = Null {};
    #pragma diagram {"xy":"H0;V0","wh":"24000;3200"} #end)
}

inline function handle (l: list;
                        idx: index;)
  returns (result: ref;)
{
  diagram
    (let result = Ref {idx: idx, version: (l.nodes .[idx] default EMPTY_SLOT).version};
    #pragma diagram {"xy":"H0;V0","wh":"68000;3200"} #end)
}

-- The version after `current`; wraps to 0 after MAX_VERSION.

inline function next_version (current: version;)
  returns (result: version;)
{
  diagram
    (let result = if current = MAX_VERSION then 0 else current + 1;
    #pragma diagram {"xy":"H0;V0","wh":"64000;3200"} #end)
}

-- The slot index of a handle; N for Null.

inline function index_of (r: ref;)
  returns (idx: index;)
{
  diagram
    (activate #0 when r match
       | Null :
         {
           diagram
             (let idx = N;
             #pragma diagram {"xy":"h-1000;v0","wh":"16000;3200"} #end)
         #pragma diagram {"xy":"h0;v-2091","wh":"30000;7200"} #end
         }
       | Ref {position} :
         {
           diagram
             (let idx = position.idx;
             #pragma diagram {"xy":"h0;v0","wh":"26000;3200"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"30000;7200"} #end
         }
     #pragma diagram {"xy":"H0;V0","wh":"30000;24819"} #end)
}

-- Initial slot `idx`: version `first`, Free, linked to the next slot.

inline function init_node (idx: index;
                           first: version;)
  returns (result: Slot;)
{
  diagram
    (let result = {
         version: first,
         entry: Free {next: if idx < N - 1 then Ref {idx: idx + 1, version: first} else null()}
         }: Slot;
    #pragma diagram {"xy":"H4000;V2369","wh":"86000;7938"} #end)
}

-- An empty list whose N slots are all free, at version `first`, chained in
-- index order in the free list.

function init_at (first: version;)
  returns (result: list;)
{
  diagram
    (let
       result = {
         nodes: (mapi (init_node \ first: first)) <<N>> (),
         head: null(),
         tail: null(),
         free_head: Ref {idx: 0, version: first},
         length: 0
       }: list;
    #pragma diagram {"xy":"H0;V0","wh":"56000;15376"} #end)
}

function init ()
  returns (result: list;)
{
  diagram
    (let result = init_at(0);
    #pragma diagram {"xy":"H0;V0","wh":"26000;3200"} #end)
}

inline function size (l: list;)
  returns (result: index;)
{
  diagram
    (let result = l.length;
    #pragma diagram {"xy":"H0;V0","wh":"26000;3200"} #end)
}

inline function front (l: list;)
  returns (result: ref;)
{
  diagram
    (let result = l.head;
    #pragma diagram {"xy":"H0;V0","wh":"24000;3200"} #end)
}

inline function back (l: list;)
  returns (result: ref;)
{
  diagram
    (let result = l.tail;
    #pragma diagram {"xy":"H0;V0","wh":"24000;3200"} #end)
}

function read (l: list;
               r: ref;)
  returns (result: Node;)
{
  diagram
    (activate #0 when r match
       | Null :
         {
           diagram
             (let result = EMPTY_NODE;
             #pragma diagram {"xy":"h-17000;v0","wh":"22000;3200"} #end)
         #pragma diagram {"xy":"h0;v-6399","wh":"62000;7200"} #end
         }
       | Ref {position} :
         {
           diagram
             (let
                stored = (l.nodes .[position.idx] default EMPTY_SLOT);
                result =
                  if stored.version = position.version
                  then stored.entry
                  else EMPTY_NODE;
             #pragma diagram {"xy":"h0;v0","wh":"58000;11657"} #end)
             
             (var
                 stored: Slot;)
         #pragma diagram {"xy":"h0;v8889","wh":"62000;15657"} #end
         }
     #pragma diagram {"xy":"H-2104;V-32182","wh":"62000;33435"} #end)
}

-- Replaces the value of a live item. The inner `Null` branch is defensive:
-- read returns Free for a Null handle, so it is not reached.

function set (l_in * : list;
              r: ref;
              value: Item::t;)
  returns (l_out at l_in: list;
           result: set_result;)
{
  diagram
    (let entry = read(l_in, r);
    #pragma diagram {"xy":"H-10325;V3888","wh":"34000;3200"} #end)
    
    (var
        entry: Node;)
    (activate #0 when entry match
       | Free {available} :
         {
           diagram
             (let l_out = l_in; result = SetInvalidRef {};
             #pragma diagram {"xy":"h-10000;v0","wh":"46000;3200"} #end)
         #pragma diagram {"xy":"h0;v-15349","wh":"70000;7200"} #end
         }
       | Used {occupied} :
         {
           diagram
             (activate #1 when r match
                | Null :
                  {
                    diagram
                      (let l_out = l_in; result = SetInvalidRef {};
                      #pragma diagram {"xy":"h-8000;v0","wh":"46000;3200"} #end)
                  #pragma diagram {"xy":"h0;v-4539","wh":"66000;7200"} #end
                  }
                | Ref {position} :
                  {
                    diagram
                      (let
                         l_out = (l_in with .nodes[position.idx].entry = Used {
                           value: value, prev: occupied.prev, next: occupied.next});
                         result = Set {};
                      #pragma diagram {"xy":"h0;v0","wh":"62000;7938"} #end)
                  #pragma diagram {"xy":"h0;v8889","wh":"66000;11938"} #end
                  }
              #pragma diagram {"xy":"h0;v80","wh":"66000;29716"} #end)
         #pragma diagram {"xy":"h0;v8889","wh":"70000;33557"} #end
         }
     #pragma diagram {"xy":"H-1000;V-28920","wh":"70000;51335"} #end)
}

-- Sets previous.next := next, or head := next when previous is Null.

inline function set_next_of (l_in * : list;
                             previous: ref;
                             next: ref;)
  returns (l_out at l_in: list;)
