       | Ref {position} :
         {
           diagram
             (let entry = !(l_in.nodes .[position.idx] default EMPTY_SLOT).entry;
             #pragma diagram {"xy":"h-1812;v-18558","wh":"70000;3200"} #end)
             
             (var
                 entry: Node;)
             (activate #1 when entry match
                | Free {available} :
                  {
                    diagram
                      (assert $occupied_neighbor: false;
                      #pragma diagram {"xy":"h-9000;v-2700","wh":"36000;3200"} #end)
                      (let l_out = !l_in;
                      #pragma diagram {"xy":"h-8100;v2700","wh":"22000;3200"} #end)
                  #pragma diagram {"xy":"h0;v-4540","wh":"76000;12600"} #end
                  }
                | Used {occupied} :
                  {
                    diagram
                      (let l_out = (l_in with .nodes[position.idx].entry = Used {
                        value: occupied.value,
                        prev: occupied.prev,
                        next: next});
                      #pragma diagram {"xy":"h0;v0","wh":"54000;7938"} #end)
                  #pragma diagram {"xy":"h0;v11589","wh":"76000;11938"} #end
                  }
              #pragma diagram {"xy":"h-1812;v2600","wh":"76000;35116"} #end)
         #pragma diagram {"xy":"h0;v9389","wh":"85975;44316"} #end
         }
     #pragma diagram {"xy":"H3788;V2105","wh":"85975;63094"} #end)
}

-- Sets next.prev := previous, or tail := previous when next is Null.

