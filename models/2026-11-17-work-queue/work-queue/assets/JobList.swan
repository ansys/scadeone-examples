-- One step of a copy: the value at `cursor` and the next handle in the given
-- direction. Past the end, `filler` and Null.

inline function copy_step (l: list;
                           cursor: ref;
                           filler: Item::t;
                           toward_tail: bool;)
  returns (value: Item::t;
           link: ref;
           present: bool;)
{
  diagram
    (let entry = read(l, cursor);
    #pragma diagram {"xy":"H-24475;V-36800","wh":"32000;3200"} #end)
    
    (var
        entry: Node;)
    (activate #0 when entry match
       | Free {available} :
         {
           diagram
             (let value = filler; link = null(); present = false;
             #pragma diagram {"xy":"h-6000;v0","wh":"52000;3200"} #end)
         #pragma diagram {"xy":"h0;v-4459","wh":"68000;7200"} #end
         }
       | Used {occupied} :
         {
           diagram
             (let
                value = occupied.value;
                link = if toward_tail then occupied.next else occupied.prev;
                present = true;
             #pragma diagram {"xy":"h0;v0","wh":"64000;7938"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"68000;11938"} #end
         }
     #pragma diagram {"xy":"H-1000;V-18000","wh":"68000;29557"} #end)
}

function copy_items <<M>> (l: list;
                           filler: Item::t;
                           toward_tail: bool;)
  returns (values: Item::t ^ M;
           refs: ref ^ M;
           count: index;)
{
  diagram
    (#2 expr forward
      <<M>>
      diagram
        (#3 block copy_step
        #pragma diagram {"xy":"h0;v0","wh":"20000;14000"} #end)
        (#4 expr l
        #pragma diagram {"xy":"h-30500;v5650"} #end)
        (#5 expr last 'cursor
        #pragma diagram {"xy":"h-34500;v-5450","wh":"16000;3200"} #end)
        (#6 expr filler
        #pragma diagram {"xy":"h-31500;v-1750","wh":"10000;3200"} #end)
        (#7 expr toward_tail
        #pragma diagram {"xy":"h-34500;v1950","wh":"16000;3200"} #end)
        (#8 def value
        #pragma diagram {"xy":"h33500;v4667","wh":"10000;3200"} #end)
        (#9 def cursor
        #pragma diagram {"xy":"h33500;v-4667","wh":"10000;3200"} #end)
        (#10 def present
        #pragma diagram {"xy":"h32500;v0","wh":"12000;3200"} #end)
        (let total = if present then last 'total + 1 else last 'total;
        #pragma diagram {"xy":"h-2000;v11300","wh":"62000;3200"} #end)
        
        (#11 wire #4 => #3 .(l))
        (#12 wire #5 => #3 .(cursor))
        (#13 wire #6 => #3 .(filler))
        (#14 wire #7 => #3 .(toward_tail))
        (#15 wire #3 .(value) => #8
        #pragma diagram {"wp":"v4667|#3 #8"} #end)
        (#16 wire #3 .(link) => #9
        #pragma diagram {"wp":"v-4667|#3 #9"} #end)
        (#17 wire #3 .(present) => #10
        #pragma diagram {"wp":"v0|#3 #10"} #end)
        
        (var
            cursor: ref last = if toward_tail then l.head else l.tail;
            value: Item::t;
            present: bool;)
      returns ([value],
               [last 'cursor],
               total: last = 0)
    #pragma diagram {"xy":"H0;V0","wh":"70600;30000"} #end)
    (#18 def values
    #pragma diagram {"xy":"H56800;V10000","wh":"10000;3200"} #end)
    (#19 def refs
    #pragma diagram {"xy":"H57800;V-10000"} #end)
    (#20 def count
    #pragma diagram {"xy":"H56800;V0","wh":"10000;3200"} #end)
    
    (#21 wire #2 .(1) => #18
    #pragma diagram {"wp":"v10000|#2 #18"} #end)
    (#22 wire #2 .(2) => #19
    #pragma diagram {"wp":"v-10000|#2 #19"} #end)
    (#23 wire #2 .(3) => #20
    #pragma diagram {"wp":"v0|#2 #20"} #end)
}

function copy_front <<M>> (l: list;
                           filler: Item::t;)
  returns (values: Item::t ^ M;
           refs: ref ^ M;
           count: index;)
{
  diagram
    (let values, refs, count = copy_items <<M>> (l, filler, true);
    #pragma diagram {"xy":"H0;V0","wh":"62000;3200"} #end)
}

function copy_back <<M>> (l: list;
                          filler: Item::t;)
  returns (values: Item::t ^ M;
           refs: ref ^ M;
           count: index;)
{
  diagram
    (let values, refs, count = copy_items <<M>> (l, filler, false);
    #pragma diagram {"xy":"H0;V0","wh":"64000;3200"} #end)
}

-- The item at `r`; Item::DEFAULT and found = false when `r` is Null,
-- out of range or stale.

function value_at (l: list;
                   r: ref;)
  returns (found: bool;
           value: Item::t;)
{
  diagram
    (let entry = read(l, r);
    #pragma diagram {"xy":"H0;V0","wh":"30000;3200"} #end)
    
    (var
        entry: Node;)
    (activate #0 when entry match
       | Free {available} :
         {
           diagram
             (let found = false; value = Item::DEFAULT;
             #pragma diagram {"xy":"h0;v0","wh":"48000;3200"} #end)
         #pragma diagram {"xy":"h0;v-2091","wh":"52000;7200"} #end
         }
       | Used {occupied} :
         {
           diagram
             (let found = true; value = occupied.value;
             #pragma diagram {"xy":"h0;v0","wh":"48000;3200"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"52000;7200"} #end
         }
     #pragma diagram {"xy":"H-1000;V-16000","wh":"52000;24819"} #end)
}

-- Queue successor (toward_tail) or predecessor of the live item at `r`; Null
-- at the ends of the queue and for a Null, out-of-range or stale handle.

inline function neighbour_of (l: list;
                              r: ref;
                              toward_tail: bool;)
  returns (link: ref;)
{
  diagram
    (let entry = read(l, r);
    #pragma diagram {"xy":"H0;V0","wh":"30000;3200"} #end)
    
    (var
        entry: Node;)
    (activate #0 when entry match
       | Free {available} :
         {
           diagram
             (let link = null();
             #pragma diagram {"xy":"h-12000;v0","wh":"24000;3200"} #end)
         #pragma diagram {"xy":"h0;v-2091","wh":"68000;7200"} #end
         }
       | Used {occupied} :
         {
           diagram
             (let link = if toward_tail then occupied.next else occupied.prev;
             #pragma diagram {"xy":"h0;v0","wh":"64000;3200"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"68000;7200"} #end
         }
     #pragma diagram {"xy":"H-1000;V-16000","wh":"68000;24819"} #end)
}

function next_of (l: list;
                  r: ref;)
  returns (next: ref;)
{
  diagram
    (let next = neighbour_of(l, r, true);
    #pragma diagram {"xy":"H0;V0","wh":"44000;3200"} #end)
}

function prev_of (l: list;
                  r: ref;)
  returns (previous: ref;)
{
  diagram
    (let previous = neighbour_of(l, r, false);
    #pragma diagram {"xy":"H0;V0","wh":"50000;3200"} #end)
}

-- One step of remove_matching at `cursor`: the next handle along the queue
-- (read before any removal), and the item removed if it matches `wanted`.
-- Past the end (Null cursor), the list is unchanged and `next` is Null.

function remove_step (l_in * : list;
                      cursor: ref;
                      wanted: Item::key;
                      count: index;)
  returns (l_out at l_in: list;
           next: ref;
           total: index;)
{
  diagram
    (let entry = !read(l_in, cursor);
    #pragma diagram {"xy":"H0;V0","wh":"36000;3200"} #end)
    
    (var
        entry: Node;)
    (activate #0 when entry match
       | Free {available} :
         {
           diagram
             (let l_out = !l_in; next = null(); total = count;
             #pragma diagram {"xy":"h-8000;v0","wh":"58000;3200"} #end)
         #pragma diagram {"xy":"h0;v-12000","wh":"78000;7200"} #end
         }
       | Used {occupied} :
         {
           diagram
             (let next = occupied.next;
             #pragma diagram {"xy":"h0;v-12000","wh":"30000;3200"} #end)
             
             (activate #1
                if Item::matches(occupied.value, wanted)
                then
                  {
                    diagram
                      (let l_out, _ = remove(l_in, cursor); total = count + 1;
                      #pragma diagram {"xy":"h0;v0","wh":"62000;3200"} #end)
                  #pragma diagram {"xy":"h0;v-3600","wh":"70000;7200"} #end
                  }
                else
                  {
                    diagram
                      (let l_out = !l_in; total = count;
                      #pragma diagram {"xy":"h-14000;v0","wh":"34000;3200"} #end)
                  #pragma diagram {"xy":"h0;v7459","wh":"70000;7200"} #end
                  }
              #pragma diagram {"xy":"h0;v4000","wh":"70000;22119"} #end)
         #pragma diagram {"xy":"h0;v12000","wh":"78000;40000"} #end
         }
     #pragma diagram {"xy":"H1350;V36825","wh":"78000;60000"} #end)
}

-- Removes every item matching `wanted`: one bounded scan of at most N steps
-- along the next links, from the head; the scan stops after the tail. The
-- survivors keep their order, slots and handles. The `_` output of the
-- partial forward is the index where the scan stopped, which is not needed.

function remove_matching (l_in * : list;
                          wanted: Item::key;)
  returns (l_out at l_in: list;
           removed: index;)
{
  diagram
    (#2 expr forward
      <<N>>
      diagram
        (#3 block remove_step
        #pragma diagram {"xy":"h1000;v-100","wh":"20000;14000"} #end)
        (#4 expr last 'l
        #pragma diagram {"xy":"h-30500;v5550","wh":"10000;3200"} #end)
        (#5 expr last 'cursor
        #pragma diagram {"xy":"h-32500;v-5550","wh":"14000;3200"} #end)
        (#6 expr wanted
        #pragma diagram {"xy":"h-31500;v-1850","wh":"12000;3200"} #end)
        (#7 expr last 'count
        #pragma diagram {"xy":"h-31500;v1850","wh":"12000;3200"} #end)
        (#8 def l
        #pragma diagram {"xy":"h34500;v4567","wh":"10000;3200"} #end)
        (#9 def cursor
        #pragma diagram {"xy":"h33500;v-4767","wh":"12000;3200"} #end)
        (#10 def count
        #pragma diagram {"xy":"h33500;v-100","wh":"12000;3200"} #end)
        
        (#11 wire #4 => #3 .(l_in))
        (#12 wire #5 => #3 .(cursor))
        (#13 wire #6 => #3 .(wanted))
        (#14 wire #7 => #3 .(count))
        (#15 wire #3 .(l_out) => #8
        #pragma diagram {"wp":"v4667|#3 #8"} #end)
        (#16 wire #3 .(next) => #9
        #pragma diagram {"wp":"v-4667|#3 #9"} #end)
        (#17 wire #3 .(total) => #10
        #pragma diagram {"wp":"v0|#3 #10"} #end)
        
        (var
            cursor: ref last = l_in.head;)
      until cursor = Null {}
      returns (l: last = l_in,
               count: last = 0)
    #pragma diagram {"xy":"H-23750;V12600","wh":"87600;30300"} #end)
    (#18 def l_out
    #pragma diagram {"xy":"H43550;V20175","wh":"10000;3200"} #end)
    (#19 def removed
    #pragma diagram {"xy":"H42550;V5025","wh":"12000;3200"} #end)
    
    (#20 wire #2 .(2) => #18
    #pragma diagram {"wp":"v7575|#2 #18"} #end)
    (#21 wire #2 .(3) => #19
    #pragma diagram {"wp":"v-7575|#2 #19"} #end)
}

-- Inspection API: the raw state of slot `idx`, for debug and teaching views.
-- A slot past N shows as free, version 0, with no successor.

function slot_info (l: list;
                    idx: index;)
  returns (info: slot_state;)
{
  diagram
    (let stored = (l.nodes .[idx] default EMPTY_SLOT);
    #pragma diagram {"xy":"H0;V0","wh":"52000;3200"} #end)
    
    (var
        stored: Slot;)
    (activate #0 when stored.entry match
       | Free {available} :
         {
           diagram
             (let info = {used: false, version: stored.version, value: Item::DEFAULT,
                prev: null(), next: available.next}: slot_state;
             #pragma diagram {"xy":"h0;v0","wh":"74000;4219"} #end)
         #pragma diagram {"xy":"h0;v-4000","wh":"78000;8219"} #end
         }
       | Used {occupied} :
         {
           diagram
             (let info = {used: true, version: stored.version, value: occupied.value,
                prev: occupied.prev, next: occupied.next}: slot_state;
             #pragma diagram {"xy":"h0;v0","wh":"74000;4219"} #end)
         #pragma diagram {"xy":"h0;v8809","wh":"78000;8219"} #end
         }
     #pragma diagram {"xy":"H-1000;V-16000","wh":"78000;26838"} #end)
}

-- Inspection API: the head of the free list (Null when the list is full).

inline function free_front (l: list;)
  returns (result: ref;)
{
  diagram
    (let result = l.free_head;
    #pragma diagram {"xy":"H0;V0","wh":"28000;3200"} #end)
}
