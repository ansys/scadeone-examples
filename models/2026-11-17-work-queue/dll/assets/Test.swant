    #pragma diagram {"xy":"H4200;V-27300","wh":"68000;7938"} #end)
    (assert $head_stays_first:
       L::front(updated) = slot(0) and prev_is(updated, 0, L::null());
    #pragma diagram {"xy":"H3400;V34000","wh":"78000;4219"} #end)
    
