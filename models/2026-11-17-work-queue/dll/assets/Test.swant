-- version swan: 2027.0 graph: 2.1 swant: 1.1
use Dll as L;

use Item;

inline function slot (idx: L::index;)
  returns (r: L::ref;)
{
  diagram
    (let r = L::Ref {idx: idx, version: 0};
    #pragma diagram {"xy":"H0;V0","wh":"40000;3200"} #end)
}

inline function slot_v (idx: L::index;
                        version: L::version;)
  returns (r: L::ref;)
{
  diagram
    (let r = L::Ref {idx: idx, version: version};
    #pragma diagram {"xy":"H0;V0","wh":"46000;3200"} #end)
}

-- Every slot has the same version in both lists (L::slot_info).

function same_versions (a: L::list;
                        b: L::list;)
  returns (same: bool;)
{
  diagram
    (let same = (foldi (slot_version_equal \ a: a, b: b)) <<L::N>> (true);
    #pragma diagram {"xy":"H0;V0","wh":"72000;3200"} #end)
}

inline function slot_version_equal (idx: L::index;
                                    acc: bool;
                                    a: L::list;
                                    b: L::list;)
  returns (same: bool;)
{
  diagram
    (let same = acc and L::slot_info(a, idx).version = L::slot_info(b, idx).version;
    #pragma diagram {"xy":"H0;V0","wh":"84000;3200"} #end)
}

-- Slot `idx` is in the same state in both lists, or is `skipped`.

inline function slot_equal_except (idx: L::index;
                                   acc: bool;
                                   a: L::list;
                                   b: L::list;
                                   skipped: L::index;)
  returns (same: bool;)
{
  diagram
    (let same = acc and (idx = skipped or L::slot_info(a, idx) = L::slot_info(b, idx));
    #pragma diagram {"xy":"H0;V0","wh":"90000;3200"} #end)
}

-- The two lists are identical except, possibly, in slot `skipped`: every
-- other slot (L::slot_info) and the endpoints, free-list head and size agree.
-- slot_info of all N slots plus these four values observe the whole list.

function same_except (a: L::list;
                      b: L::list;
                      skipped: L::index;)
  returns (same: bool;)
{
  diagram
    (let same = (foldi (slot_equal_except \ a: a, b: b, skipped: skipped)) <<L::N>> (true)
       and L::front(a) = L::front(b) and L::back(a) = L::back(b)
       and L::free_front(a) = L::free_front(b) and L::size(a) = L::size(b);
    #pragma diagram {"xy":"H0;V0","wh":"96000;6078"} #end)
}

-- The list holds exactly `count` items: `ahead` from head to tail, `behind` from tail to head.

inline function order_is (l: L::list;
                          ahead: int32 ^ 4;
                          behind: int32 ^ 4;
                          count: L::index;)
  returns (matches: bool;)
{
  diagram
    (let front_values, _, front_count = L::copy_front <<4>> (l, 0);
    #pragma diagram {"xy":"H0;V0","wh":"64000;3200"} #end)
    (let back_values, _, back_count = L::copy_back <<4>> (l, 0);
    #pragma diagram {"xy":"H0;V-11200","wh":"60000;3200"} #end)
    (let matches = front_values = ahead and back_values = behind
       and front_count = count and back_count = count and L::size(l) = count;
    #pragma diagram {"xy":"H-1400;V-5600","wh":"70000;4219"} #end)
    
    (var
        front_values: int32 ^ 4;
        back_values: int32 ^ 4;
        front_count: L::index;
        back_count: L::index;)
}

-- No live item at handle `r` (L::value_at).

inline function is_free (l: L::list;
                         r: L::ref;)
  returns (matches: bool;)
{
  diagram
    (let
       found, _ = L::value_at(l, r);
       matches = not found;
    #pragma diagram {"xy":"H0;V0","wh":"40000;6078"} #end)
    
    (var
        found: bool;)
}

-- Nothing at handle `r`: no item, the filler value, no queue neighbours.

inline function reads_nothing (l: L::list;
                               r: L::ref;)
  returns (matches: bool;)
{
  diagram
    (let
       found, value = L::value_at(l, r);
       matches = not found and value = Item::DEFAULT
         and L::next_of(l, r) = L::null() and L::prev_of(l, r) = L::null();
    #pragma diagram {"xy":"H0;V0","wh":"80000;7938"} #end)
    
    (var
        found: bool;
        value: int32;)
}

-- The live item at handle `r` holds `value`, between `prev` and `next`.

inline function item_is (l: L::list;
                         r: L::ref;
                         value: int32;
                         prev: L::ref;
                         next: L::ref;)
  returns (matches: bool;)
{
  diagram
    (let
       found, stored = L::value_at(l, r);
       matches = found and stored = value
         and L::prev_of(l, r) = prev and L::next_of(l, r) = next;
    #pragma diagram {"xy":"H0;V0","wh":"72000;7938"} #end)
    
    (var
        found: bool;
        stored: int32;)
}

-- The `next` link of slot `idx` (queue link if used, free-list link if free).

inline function next_is (l: L::list;
                         idx: L::index;
                         expected: L::ref;)
  returns (matches: bool;)
{
  diagram
    (let matches = L::slot_info(l, idx).next = expected;
    #pragma diagram {"xy":"H0;V0","wh":"56000;3200"} #end)
}

-- Slot `idx` is used and its `prev` link is `expected`.

inline function prev_is (l: L::list;
                         idx: L::index;
                         expected: L::ref;)
  returns (matches: bool;)
{
  diagram
    (let matches = L::slot_info(l, idx).used and L::slot_info(l, idx).prev = expected;
    #pragma diagram {"xy":"H0;V0","wh":"84000;3200"} #end)
}

-- Slot `idx` is free (no payload: filler value, no prev) with free-list
-- successor `next`.

inline function free_slot_is (l: L::list;
                              idx: L::index;
                              next: L::ref;)
  returns (matches: bool;)
{
  diagram
    (let
       info = L::slot_info(l, idx);
       matches = not info.used and info.value = Item::DEFAULT
         and info.prev = L::null() and info.next = next;
    #pragma diagram {"xy":"H0;V0","wh":"64000;7938"} #end)
    
    (var
        info: L::slot_state;)
}

