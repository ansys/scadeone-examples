       invalid_full, invalid_result =
          L::insert_after(!updated, slot(L::N), 9);
    #pragma diagram {"xy":"H0;V0","wh":"76000;13516"} #end)
    (assert $wrappers_full_unchanged:
       L::size(updated) < L::N
       or (front_result = L::Full {} and front_full = updated
          and back_result = L::Full {} and back_full = updated
          and after_result = L::Full {} and after_full = updated
          and null_result = L::Full {} and null_full = updated);
    #pragma diagram {"xy":"H2300;V-13800","wh":"60000;11657"} #end)
    (assert $insert_after_invalid_precedes_full:
       invalid_result = L::InsertInvalidRef {} and invalid_full = updated;
    #pragma diagram {"xy":"H1600;V-35200","wh":"70000;4219"} #end)
    (let
       _stop_condition = _current_cycle >= (L::N :> uint64) + 2;
       current = L::init() -> pre updated;
