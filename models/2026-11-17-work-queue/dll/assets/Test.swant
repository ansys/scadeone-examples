       rejected, rejection = L::insert_before(!current, slot(L::N), 99);
    #pragma diagram {"xy":"H2400;V14400","wh":"76000;9797"} #end)
    (assert $invalid_position_precedes_capacity:
       rejection = L::InsertInvalidRef {} and rejected = current;
    #pragma diagram {"xy":"H0;V-40500","wh":"62000;4219"} #end)
    (assert $fills_every_slot:
       _current_cycle > (L::N :> uint64)
       or (result = L::Inserted {ref: slot((_current_cycle - 1 :> L::index))}
          and L::size(updated) = (_current_cycle :> L::index));
    #pragma diagram {"xy":"H4400;V26400","wh":"80000;7938"} #end)
    (assert $full_does_not_modify:
       _current_cycle <= (L::N :> uint64)
