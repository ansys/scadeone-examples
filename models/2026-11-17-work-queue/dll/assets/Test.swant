       gone, _ = L::remove(!one, slot(0));
       reused, r2 = L::push_back(!gone, 20);
       stale_remove, stale_remove_result = L::remove(!reused, slot(0));
       stale_set, stale_set_result = L::set(!reused, slot(0), 99);
       stale_insert, stale_insert_result = L::insert_before(!reused, slot(0), 99);
       stale_after, stale_after_result = L::insert_after(!reused, slot(0), 99);
       stale_move, stale_move_result = L::move_before(!reused, slot(0), L::null());
       at_max = L::init_at(L::MAX_VERSION);
       filled, r3 = L::push_back(!at_max, 30);
       wrapped, _ = L::remove(!filled, slot_v(0, L::MAX_VERSION));
    #pragma diagram {"xy":"H0;V0","wh":"78000;24673"} #end)
    (assert
     $first_handle: r1 = L::Inserted {ref: slot(0)};
     $reuse_bumps_version: r2 = L::Inserted {ref: slot_v(0, 1)}
       and item_is(reused, slot_v(0, 1), 20, L::null(), L::null());
     $stale_read: is_free(reused, slot(0));
     $stale_remove: stale_remove_result = L::RemoveInvalidRef {} and stale_remove = reused;
     $stale_set: stale_set_result = L::SetInvalidRef {} and stale_set = reused;
     $stale_insert: stale_insert_result = L::InsertInvalidRef {} and stale_insert = reused;
     $stale_insert_after: stale_after_result = L::InsertInvalidRef {} and stale_after = reused;
     $stale_move: stale_move_result = L::MoveInvalidRef {} and stale_move = reused;
     $handle_tracks_version: L::handle(reused, 0) = slot_v(0, 1) and L::handle(reused, 1) = slot(1);
     $next_version: L::next_version(5) = 6 and L::next_version(L::MAX_VERSION) = 0;
     $handle_at_max: r3 = L::Inserted {ref: slot_v(0, L::MAX_VERSION)};
     $version_wraps_to_zero: L::slot_info(wrapped, 0).version = 0 and L::free_front(wrapped) = slot(0)
       and L::size(wrapped) = 0;
    #pragma diagram {"xy":"H-3700;V-29600","wh":"94000;28392"} #end)
    
    (var
        one: L::list;
        gone: L::list;
        reused: L::list;
        stale_remove: L::list;
        stale_set: L::list;
        stale_insert: L::list;
        stale_after: L::list;
        stale_move: L::list;
        at_max: L::list;
        filled: L::list;
        wrapped: L::list;
        r1: L::insert_result;
        r2: L::insert_result;
        r3: L::insert_result;
        stale_remove_result: L::remove_result;
        stale_set_result: L::set_result;
        stale_insert_result: L::insert_result;
        stale_after_result: L::insert_result;
        stale_move_result: L::move_result;)
}

_harness moves
{
  diagram
    (let
       _stop_condition = _current_cycle >= 1;
       a, _ = L::push_back(!L::init(), 10);
       b, _ = L::push_back(!a, 20);
       c, _ = L::push_back(!b, 30);
       base, _ = L::push_back(!c, 40);
       to_front, r_front = L::move_before(!base, slot(3), slot(0));
       to_back, r_back = L::move_before(!base, slot(0), L::null());
       forward_move, r_forward = L::move_before(!base, slot(1), slot(3));
       backward_move, r_backward = L::move_before(!base, slot(2), slot(1));
       onto_itself, r_itself = L::move_before(!base, slot(1), slot(1));
       beside_itself, r_beside = L::move_before(!base, slot(1), slot(2));
       tail_to_back, r_tail = L::move_before(!base, slot(3), L::null());
       holed, _ = L::remove(!base, slot(2));
       stale_target, r_stale_target = L::move_before(!holed, slot(1), slot(2));
       stale_item, r_stale_item = L::move_before(!holed, slot(2), slot(0));
       pair, _ = L::push_back(!a, 20);
       swapped, r_swap = L::move_before(!pair, slot(0), L::null());
    #pragma diagram {"xy":"H0;V0","wh":"74000;33970"} #end)
    (assert
     $setup: L::size(base) = 4 and L::free_front(base) = slot(4);
     $tail_to_front: r_front = L::Moved {}
       and order_is(to_front, [40, 10, 20, 30], [30, 20, 10, 40], 4);
     $head_to_back: r_back = L::Moved {}
       and order_is(to_back, [20, 30, 40, 10], [10, 40, 30, 20], 4);
     $move_forward: r_forward = L::Moved {}
       and order_is(forward_move, [10, 30, 20, 40], [40, 20, 30, 10], 4);
     $move_backward: r_backward = L::Moved {}
       and order_is(backward_move, [10, 30, 20, 40], [40, 20, 30, 10], 4);
     $onto_itself_is_noop: r_itself = L::Moved {} and onto_itself = base;
     $beside_itself_is_noop: r_beside = L::Moved {} and beside_itself = base;
     $tail_to_back_is_noop: r_tail = L::Moved {} and tail_to_back = base;
     $two_items: r_swap = L::Moved {} and order_is(swapped, [20, 10, 0, 0], [10, 20, 0, 0], 2);
     $stale_target: r_stale_target = L::MoveInvalidRef {} and stale_target = holed;
     $stale_item: r_stale_item = L::MoveInvalidRef {} and stale_item = holed;
     $handles_survive_moves:
       item_is(to_front, slot(3), 40, L::null(), slot(0))
       and same_versions(to_front, base)
       and L::free_front(to_front) = L::free_front(base)
       and item_is(forward_move, slot(1), 20, slot(2), slot(3));
    #pragma diagram {"xy":"H-4200;V-42000","wh":"90000;39549"} #end)
    
    (var
        a: L::list;
        b: L::list;
        c: L::list;
        base: L::list;
        to_front: L::list;
        to_back: L::list;
        forward_move: L::list;
        backward_move: L::list;
        onto_itself: L::list;
        beside_itself: L::list;
        tail_to_back: L::list;
        holed: L::list;
        stale_target: L::list;
        stale_item: L::list;
        pair: L::list;
        swapped: L::list;
        r_front: L::move_result;
        r_back: L::move_result;
        r_forward: L::move_result;
        r_backward: L::move_result;
        r_itself: L::move_result;
        r_beside: L::move_result;
        r_tail: L::move_result;
        r_stale_target: L::move_result;
        r_stale_item: L::move_result;
        r_swap: L::move_result;)
}

_harness copies
{
  diagram
    (let
       _stop_condition = _current_cycle >= 1;
       empty = L::init();
       a, _ = L::push_back(!empty, 10);
       b, _ = L::push_back(!a, 20);
       c, _ = L::push_back(!b, 30);
       moved, _ = L::move_before(!c, slot(2), slot(0));
       empty_values, empty_refs, empty_count = L::copy_front <<3>> (empty, -1);
       front_values, front_refs, front_count = L::copy_front <<5>> (moved, -1);
       back_values, back_refs, back_count = L::copy_back <<2>> (moved, -1);
       one_values, one_refs, one_count = L::copy_front <<1>> (moved, -1);
    #pragma diagram {"xy":"H0;V0","wh":"74000;20954"} #end)
    (assert
     $empty_list: empty_values = [-1, -1, -1]
       and empty_refs = [L::null(), L::null(), L::null()] and empty_count = 0;
     $list_order_and_filler: front_values = [30, 10, 20, -1, -1] and front_count = 3;
     $handles_follow_values:
       front_refs = [slot(2), slot(0), slot(1), L::null(), L::null()];
     $from_the_tail_truncated: back_values = [20, 10] and back_refs = [slot(1), slot(0)]
       and back_count = 2;
     $single_entry: one_values = [30] and one_refs = [slot(2)] and one_count = 1;
     $copy_leaves_list_unchanged: L::size(moved) = 3;
    #pragma diagram {"xy":"H-3400;V-23800","wh":"82000;19095"} #end)
    
    (var
        empty: L::list;
        a: L::list;
        b: L::list;
        c: L::list;
        moved: L::list;
        empty_values: int32 ^ 3;
        empty_refs: L::ref ^ 3;
        empty_count: L::index;
        front_values: int32 ^ 5;
        front_refs: L::ref ^ 5;
        front_count: L::index;
        back_values: int32 ^ 2;
        back_refs: L::ref ^ 2;
        back_count: L::index;
        one_values: int32 ^ 1;
        one_refs: L::ref ^ 1;
        one_count: L::index;)
}
