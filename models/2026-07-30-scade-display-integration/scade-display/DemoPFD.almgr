  <traceableElements id="_HL3l6RomEe2bYbYNsRHdzw" name="FCU_01" identifier="FCU_01" description="Altitude contribution is corrected with a gain altKp."/>
  <traceableElements id="_HL3l6homEe2bYbYNsRHdzw" name="FCU_04" identifier="FCU_04" description="The altitude contribution is centered on 50%"/>
  <traceableElements id="_HL3l6xomEe2bYbYNsRHdzw" name="FCU_02" identifier="FCU_02" description="Speed contribution is regulated with a PI, and transformed into an angle using a lookup table."/>
  <traceableElements id="_HL3l7BomEe2bYbYNsRHdzw" name="FCU_03" identifier="FCU_03" description="The value of the elevator command is the corrected altitude error contribution minus the corrected speed error contribution."/>
  <traceableElements id="_HL3l7RomEe2bYbYNsRHdzw" name="FCU_05" identifier="FCU_05" description="The value of the throttle command is the corrected altitude error contribution plus the corrected speed error contribution"/>
  <traceableElements id="_HL3l7homEe2bYbYNsRHdzw" name="FCU_06" identifier="FCU_06" description="Altitude Alarm is triggered if the measured altitude moves away from the altitude set point more than alarmAltThreshold, during more than alarmAltTimer time cycles"/>
  <traceableElements id="_HL3l7xomEe2bYbYNsRHdzw" name="FCU_07" identifier="FCU_07" description="Speed Alarm is triggered if the measured speed moves away from the speed set point more than alarmSpeedThreshold, during more than alarmSpeedTimer time cycles"/>
  <traceableElements id="_HL3l8BomEe2bYbYNsRHdzw" name="FCU_08" identifier="FCU_08" description="The FCU shall provide information about the flight: speed, altitude with hundredth, pitch angle, and roll angle."/>
  <traceableElements id="_HL3l8RomEe2bYbYNsRHdzw" name="PFD_01" identifier="PFD_01" description="The display shall indicate the Heading value on a scale graduated from 0 to 360."/>
  <traceableElements id="_HL3l8homEe2bYbYNsRHdzw" name="PFD_02" identifier="PFD_02" description="The display shall indicate the Vertical Speed on the left side."/>
  <traceableElements id="_HL3l8xomEe2bYbYNsRHdzw" identifier="b6309698-e41b-46e8-8e9b-f9550b909d45"/>
  <traceableElements id="_HL3l9BomEe2bYbYNsRHdzw" identifier="4e3aefd7-e6fc-4f56-b73b-e5e705e672ec"/>
  <traceableElements id="_HL3l9RomEe2bYbYNsRHdzw" name="PFD_03" identifier="PFD_03" description="The display shall indicate the Altitude on the right side."/>
