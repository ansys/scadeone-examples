    #pragma diagram {"xy":"H79670;V99085"} #end)
    (#7 def X2
    #pragma diagram {"xy":"H78510;V110250"} #end)
    (#8 expr (X . [Idx] default (0.0 :> 'T))
    #pragma diagram {"xy":"H36200;V99165","wh":"34000;3200"} #end)
    (#9 expr (X . [Idx + 1_i32] default (0.0 :> 'T))
    #pragma diagram {"xy":"H31800;V110175","wh":"42000;3200"} #end)
    (#10 def idx
    #pragma diagram {"xy":"H68030;V37245"} #end)
    (assume
           $A1: (fold (and)) <<Xs - 1>> $N2 (true, (map (function a_1, b_1 => a_1 <= b_1)) <<Xs - 1>> $N3 (X[0 .. Xs - 2], X[1 .. Xs - 1]));
    #pragma diagram {"xy":"H2400;V19200","wh":"66000;11657"} #end)
    
    (#17 wire #9 => #7)
    (#18 wire #5 => #1 .(2))
    (#19 wire #4 => #1 .(3))
    (#20 wire #8 => #6)
    (#21 wire #1 .(1) => #10, #2
    #pragma diagram {"wp":"v-2037|#1 h2000[v-31598 h-40140 v31635 #10, h21090 v-38 #2]"} #end)
    (#22 wire #3 => #1 .(1))
    
    (var
        idx: int32;
        X2: 'T;
        X1: 'T;)
    (activate #24 $IfBlock2
      if X1 = X2
      then
        {
          diagram
            (#14 def F
            #pragma diagram {"xy":"h14000;v0"} #end)
            (#15 expr (0.0 :> 'T)
            #pragma diagram {"xy":"h-10000;v0","wh":"16000;3200"} #end)
            
            (#16 wire #15 => #14)
        #pragma diagram {"xy":"h0;v-3770","wh":"50000;7200"} #end
        }
      else
        {
          diagram
            (#11 expr (InX - X1) / (X2 - X1)
            #pragma diagram {"xy":"h-10000;v0","wh":"26000;3200"} #end)
            (#12 def F
            #pragma diagram {"xy":"h19000;v0"} #end)
            
            (#13 wire #11 => #12)
        #pragma diagram {"xy":"h0;v7630","wh":"50000;7200"} #end
        }
    #pragma diagram {"xy":"H0;V0","wh":"50000;22459"} #end)
}

