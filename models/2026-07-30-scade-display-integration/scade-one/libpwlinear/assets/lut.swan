inline function PreLutNoSat <<Xs>> (InX: 'T;
                                    X: 'T^Xs;)
  returns (F: 'T;
           Idx: int32;)
  where 'T float
{
  diagram
    (#1 $N1 block (foldi SearchIdx) <<Xs - 1>>
    #pragma diagram {"xy":"H82100;V37245","wh":"36140;61270"} #end)
    (#2 def Idx
    #pragma diagram {"xy":"H136290;V37170"} #end)
    (#3 expr 0_i32
