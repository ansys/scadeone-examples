inline function #pragma doc Performs piecewise linear interpolation to approximate y = f(x) with <Xs> points set as vectors
                X and Y. X values must increase strictly monotonically. For out-of-bounds input, Extrapol
                parameter allows linear extrapolation, otherwise the end-point values are output. #end Lut1D <<Xs>> (InX: 'T;
                                                                                                                     X: 'T^Xs;
                                                                                                                     Y: 'T^Xs;
                                                                                                                     Extrapol: bool;)
  returns (OutY: 'T;)
  where 'T float
{
  diagram
    (#1 $N1 block (Lut1DNoSat <<Xs>>  \ X: X, Y: Y)
    #pragma diagram {"xy":"H169280;V23495","wh":"45400;22650"} #end)
    (#2 expr Xsat
    #pragma diagram {"xy":"H120690;V23155"} #end)
    (#3 def OutY
    #pragma diagram {"xy":"H219570;V23415"} #end)
    
    (#12 wire #2 => #1 .(InX))
    (#13 wire #1 .(OutY) => #3
    #pragma diagram {"wp":"v-80|#1 #3"} #end)
    
    (var
        Xsat: 'T;)
    (activate #0 $IfBlock1
      if Extrapol
      then
        {
          diagram
            (#9 def Xsat
            #pragma diagram {"xy":"h10000;v0"} #end)
            (#10 expr InX
            #pragma diagram {"xy":"h-10000;v0"} #end)
            
            (#11 wire #10 => #9)
        #pragma diagram {"xy":"h0;v-7275","wh":"81710;7200"} #end
        }
      else
        {
          diagram
            (#4 def Xsat
            #pragma diagram {"xy":"h34855;v0"} #end)
            (#5 expr InX
            #pragma diagram {"xy":"h-34855;v0"} #end)
            (#6 $N2 block (Limiter2 \ Low: X[0], High: X[Xs - 1])
            #pragma diagram {"xy":"h-3150;v0","wh":"20010;10210"} #end)
            
            (#7 wire #6 .(LimitedVal) => #4
            #pragma diagram {"wp":"v0|#6 #4"} #end)
            (#8 wire #5 => #6 .(Val))
        #pragma diagram {"xy":"h0;v7630","wh":"81710;14210"} #end
        }
    #pragma diagram {"xy":"H0;V0","wh":"81710;29469"} #end)
}

