function #pragma doc Builds an array of N elements, where each element value is the previous element plus Inc, first element being StartIdx #end BuildArray <<N>> (StartValue: 'T;
                                                                                                                                                                   Increment: 'T;)
  returns (Output: 'T^N;)
  where 'T numeric
{
  diagram
    (#1 $N1 block (mapfold SumDup) <<N>>
    #pragma diagram {"xy":"H83345;V23150","wh":"27150;21060"} #end)
    (#2 expr StartValue
    #pragma diagram {"xy":"H16110;V18175","wh":"14000;3200"} #end)
    (#3 expr Increment
    #pragma diagram {"dir":"es","xy":"H46565;V58550","wh":"3200;14000"} #end)
    (#4 def Output
    #pragma diagram {"xy":"H136000;V26590","wh":"10000;3200"} #end)
    (#5 def _
    #pragma diagram {"xy":"H134700;V19450"} #end)
    (#7 expr #6 ^ (N)
      where
        (#6 group)
    #pragma diagram {"dir":"es","xy":"H46835;V44020","wh":"7000;10000"} #end)
    (#8 expr (Increment :> 'T)
    #pragma diagram {"xy":"H23150;V23820","wh":"20000;3200"} #end)
    (#11 expr #10 - #9
      where
        (#10 group)
        (#9 group)
    #pragma diagram {"xy":"H47670;V19445"} #end)
    
    (#12 wire #1 .(1) => #5
    #pragma diagram {"wp":"v-5700|#1 #5"} #end)
    (#13 wire #8 => #9
    #pragma diagram {"wp":"#8 h6260 v-2475 #9"} #end)
    (#14 wire #7 => #1 .(2)
    #pragma diagram {"wp":"#7 v-12208 #1"} #end)
    (#15 wire #11 => #1 .(1))
    (#16 wire #3 => #6
    #pragma diagram {"wp":"#3 v-2030 h270 #6"} #end)
    (#17 wire #1 .(2) => #4
    #pragma diagram {"wp":"v1440|#1 #4"} #end)
    (#18 wire #2 => #10
    #pragma diagram {"wp":"#2 h16300 v-630 #10"} #end)
}

function #pragma doc Computes the determinant of a square matrix of type 'T^2^2 #end Det2x2 (A: 'T^2^2;)
  returns (Det: 'T;)
  where 'T numeric
{
  diagram
    (let Det = A[0][0] * A[1][1] - A[0][1] * A[1][0];
    #pragma diagram {"xy":"H0;V0","wh":"50000;3200"} #end)
}

function #pragma doc Computes the determinant of a square matrix of type 'T^3^3 #end Det3x3 (A: 'T^3^3;)
  returns (Det: 'T;)
  where 'T numeric
{
  diagram
    (let
        Det = A[0][0] * C00 + A[0][1] * C01 + A[0][2] * C02;
        C00 = A[1][1] * A[2][2] - A[1][2] * A[2][1];
        C01 = -A[1][0] * A[2][2] + A[1][2] * A[2][0];
        C02 = A[1][0] * A[2][1] - A[1][1] * A[2][0];
    #pragma diagram {"xy":"H0;V0","wh":"56000;9797"} #end)
    
    (var
        C00: 'T;
        C01: 'T;
        C02: 'T;)
}

function #pragma doc Computes the determinant of a square matrix of type 'T^4^4 #end Det4x4 (A: 'T^4^4;)
  returns (Det: 'T;)
  where 'T numeric
{
  diagram
    (let
        Det = A[0][0] * C00 + A[0][1] * C01 + A[0][2] * C02 + A[0][3] * C03;
        C00 = A[1][1] * C0011 + A[2][1] * C0021 + A[3][1] * C0031;
        C0011 = A[2][2] * A[3][3] - A[2][3] * A[3][2];
        C0021 = -A[1][2] * A[3][3] + A[1][3] * A[3][2];
        C0031 = A[1][2] * A[2][3] - A[1][3] * A[2][2];
        C01 = A[1][0] * C0110 + A[2][0] * C0120 + A[3][0] * C0130;
        C0110 = -A[2][2] * A[3][3] + A[2][3] * A[3][2];
        C0120 = A[1][2] * A[3][3] - A[1][3] * A[3][2];
        C0130 = -A[1][2] * A[2][3] + A[1][3] * A[2][2];
        C02 = A[1][0] * C0210 + A[2][0] * C0220 + A[3][0] * C0230;
        C0210 = A[2][1] * A[3][3] - A[2][3] * A[3][1];
        C0220 = -A[1][1] * A[3][3] + A[1][3] * A[3][1];
        C0230 = A[1][1] * A[2][3] - A[1][3] * A[2][1];
        C03 = A[1][0] * C0310 + A[2][0] * C0320 + A[3][0] * C0330;
        C0310 = -A[2][1] * A[3][2] + A[2][2] * A[3][1];
        C0320 = A[1][1] * A[3][2] - A[1][2] * A[3][1];
        C0330 = -A[1][1] * A[2][2] + A[1][2] * A[2][1];
    #pragma diagram {"xy":"H0;V0","wh":"70000;33970"} #end)
    
    (var
        C00: 'T;
        C01: 'T;
        C02: 'T;
        C03: 'T;
        C0330: 'T;
        C0320: 'T;
        C0310: 'T;
        C0230: 'T;
        C0220: 'T;
        C0210: 'T;
        C0130: 'T;
        C0120: 'T;
        C0110: 'T;
        C0031: 'T;
        C0021: 'T;
        C0011: 'T;)
}

function #pragma doc Inverses a square matrix of type real^2^2
         
         Error output is set to true when the determinant
         of the matrix is lower or equal to Epsilon input
         
         It is assumed that Epsilon is a positive value #end Inv2x2 (A: 'T^2^2;
                                                                     Epsilon: 'T;)
  returns (InvA: 'T^2^2;
           Error: bool;)
  where 'T float
{
  diagram
    (#1 $N1 block Det2x2
    #pragma diagram {"xy":"H38765;V11770","wh":"17730;14020"} #end)
    (#2 expr A
    #pragma diagram {"xy":"H17690;V11775"} #end)
    (#3 def Det
    #pragma diagram {"xy":"H60090;V11775"} #end)
    (#4 def Error
    #pragma diagram {"xy":"H88090;V26850","wh":"10000;3200"} #end)
    (#5 expr if Det < 0.0 then -Det else Det
    #pragma diagram {"xy":"H52020;V25610","wh":"36000;3200"} #end)
    (#6 expr Epsilon
    #pragma diagram {"xy":"H52630;V32415","wh":"12000;3200"} #end)
    (#9 expr #8 <= #7
      where
        (#8 group)
        (#7 group)
    #pragma diagram {"xy":"H72270;V26855"} #end)
    (assume
           $A1: Epsilon >= 0.0;
    #pragma diagram {"xy":"H1000;V4000","wh":"30000;3200"} #end)
    
    (#10 wire #1 .(Det) => #3
    #pragma diagram {"wp":"v5|#1 #3"} #end)
    (#11 wire #9 => #4)
    (#12 wire #2 => #1 .(A))
    (#13 wire #6 => #7
    #pragma diagram {"wp":"#6 h5820 v-3660 #7"} #end)
    (#14 wire #5 => #8
    #pragma diagram {"wp":"#5 h3250 v-2428 h-6500 v1773 #8"} #end)
    
    (var
        Det: 'T;)
    (activate #15 $IfBlock1
      if Error
      then
        {
          diagram
            (let InvA = 0.0^2^2;
            #pragma diagram {"xy":"h0;v0","wh":"22000;3200"} #end)
        #pragma diagram {"xy":"h0;v-4280","wh":"82000;7200"} #end
        }
      else
        {
          diagram
            (let InvA = [[A[1][1] / Det, -A[0][1] / Det], [-A[1][0] / Det, A[0][0] / Det]];
            #pragma diagram {"xy":"h0;v0","wh":"78000;4219"} #end)
        #pragma diagram {"xy":"h0;v7630","wh":"82000;8219"} #end
        }
    #pragma diagram {"xy":"H3700;V-11100","wh":"82000;23478"} #end)
}

