function #pragma doc Computes the sum of two matrices of type 'T^n^m #end MatAdd <<m, n>> (A: 'T^n^m;
                                                                                           B: 'T^n^m;)
  returns (C: 'T^n^m;)
  where 'T numeric
{
  diagram
    (#1 $N1 block (map VectAdd <<n>> ) <<m>>
    #pragma diagram {"xy":"H37125;V20585","wh":"26090;22650"} #end)
    (#2 expr A
    #pragma diagram {"xy":"H12400;V16530"} #end)
    (#3 expr B
    #pragma diagram {"xy":"H12410;V24215"} #end)
    (#4 def C
    #pragma diagram {"xy":"H63270;V20505"} #end)
    
    (#5 wire #3 => #1 .(2))
    (#6 wire #1 .(1) => #4
    #pragma diagram {"wp":"v-2080|#1 #4"} #end)
    (#7 wire #2 => #1 .(1))
}

function #pragma doc Computes the matrix product A*B, 
         matrixes (m,n) implemented as 'T^n^m #end MatProd <<m, n, p>> (A: 'T^n^m;
                                                                        B: 'T^p^n;)
  returns (C: 'T^p^m;)
  where 'T numeric
