inline function #pragma doc Perform evaluation of polynomial coefficients on input values. #end Polynomial <<N>> (X: 'T;
                                                                                                                  C: 'T^N;)
  returns (Y: 'T;)
  where 'T numeric
{
  diagram
    (#1 $N1 block (fold PolynomialStep) <<N>>
    #pragma diagram {"xy":"H102980;V26040","wh":"46940;35720"} #end)
    (#2 expr (0 :> 'T)
    #pragma diagram {"xy":"H22470;V17035","wh":"14000;3200"} #end)
    (#3 expr X
    #pragma diagram {"xy":"H25310;V25795"} #end)
    (#5 expr #4 ^ (N)
      where
        (#4 group)
    #pragma diagram {"xy":"H57550;V25935","wh":"10000;7000"} #end)
    (#6 expr C
    #pragma diagram {"xy":"H25320;V34905"} #end)
    (#7 def Y
    #pragma diagram {"xy":"H148990;V25790"} #end)
    
    (#8 wire #6 => #1 .(3))
    (#9 wire #5 => #1 .(2))
    (#10 wire #3 => #4
    #pragma diagram {"wp":"#3 h13200 v140 #4"} #end)
    (#11 wire #2 => #1 .(1))
    (#12 wire #1 .(1) => #7
    #pragma diagram {"wp":"v-2250|#1 #7"} #end)
}

inline function PolynomialStep (Acc: 'T;
