    (#4 def Y
    #pragma diagram {"xy":"H88930;V9655"} #end)
    (#7 expr #6 * #5
      where
        (#6 group)
        (#5 group)
    #pragma diagram {"xy":"H34900;V8335"} #end)
    (#10 expr #9 + #8
      where
        (#9 group)
        (#8 group)
    #pragma diagram {"xy":"H61880;V9660"} #end)
    
    (#11 wire #2 => #5
    #pragma diagram {"wp":"#2 h10495 v-6040 #5"} #end)
    (#12 wire #7 => #9
    #pragma diagram {"wp":"#7 h9990 v-575 #9"} #end)
    (#13 wire #1 => #6
