    #pragma diagram {"wp":"v5|#4 #1"} #end)
    
    (var
        Alarm: bool;)
    (automaton #0 $AlarmMgt
      initial state #5 AlarmDetection
      #pragma diagram {"xy":"h-2250;v2230","wh":"90000;14078"} #end :
        diagram
          (#6 def AlarmConfirmed
          #pragma diagram {"xy":"h32000;v0","wh":"18000;3200"} #end)
          (#7 expr Flows::Times $N2 (AlarmConfirmedTimer, Alarm) or (false -> pre AlarmConfirmed)
          #pragma diagram {"xy":"h-15000;v0","wh":"52000;6078"} #end)
          
          (#8 wire #7 => #6)
      :1: #5 unless if (not Alarm)
      restart #5
      #pragma diagram {"tp":"h26250;v7039|#5 v2000 h10500 h36750;v7039|#5"} #end;
    #pragma diagram {"xy":"H4400;V-13200","wh":"102500;26539"} #end)
