# Compiler
CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -pedantic -Wno-overlength-strings

# Include directories
INCLUDES = -I../../swan_cg \
           -I../../kcgdisplay \
           -I../src \
           -I../../../include \            # Include directory for OGLX
           -I../../../extras/utils/include # Include directory for OGLX

# Defines
DEFS = -DES2_DEV_ENV -DGL_GLEXT_PROTOTYPES

# Libraries
LIBS = -lGLESv2 -lEGL -lm -lc -lX11 -lOGLXES2

# Library paths / objects
LIBPATH = -L../../../lib

# Source files
SRC = $(wildcard ../../swan_cg/*.c) \
      $(wildcard ../../kcgdisplay/*.c) \
      $(wildcard ../src/*.c) \
      $(wildcard ../../../extras/utils/src/*.c)

# Build directory for object files (mirrors source tree)
BUILDDIR = build

# Object files (one .o per .c, placed under BUILDDIR)
OBJ = $(patsubst %.c,$(BUILDDIR)/%.o,$(SRC))

# Dependency files (auto-generated by the compiler)
DEP = $(OBJ:.o=.d)

# Output
TARGET = flightControlSystem

# Default target
all: $(TARGET)

# Link step
$(TARGET): $(OBJ)
	$(CC) $(OBJ) -o $(TARGET) $(LIBPATH) $(LIBS)

# Compile step: one .c -> one .o, with auto-generated header dependencies
$(BUILDDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) $(DEFS) -MMD -MP -c $< -o $@

# Include auto-generated header dependencies (silently if missing)
-include $(DEP)

# Clean rule
clean:
	rm -rf $(TARGET) ../kcgdisplay src ../swan_cg 

.PHONY: all clean