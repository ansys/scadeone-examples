node ArrayIntegrator (xDot: float64^N;
                      x0: float64^N;)
  returns (x: float64^N;)
{
  diagram
    (#0 expr xDot
    #pragma diagram {"xy":"H-44900;V5775"} #end)
    (#1 expr x0
    #pragma diagram {"xy":"H-44900;V11875"} #end)
    (#2 def x
    #pragma diagram {"xy":"H418;V9075"} #end)
    (#3 block (map IntegratorBwd) <<N>>
    #pragma diagram {"xy":"H-23066;V7075","wh":"20000;18000"} #end)
    
    (#5 wire #0 => #3 .(u))
    (#6 wire #1 => #3 .(yInit))
    (#7 wire #3 .(y) => #2
    #pragma diagram {"wp":"v0|#3 #2"} #end)
}

